ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS desktop-base
COPY image/packages.txt /tmp/zeus-packages.txt
COPY image/repos/google-chrome.repo /etc/yum.repos.d/google-chrome.repo
COPY image/keys/google-linux.asc /etc/pki/rpm-gpg/RPM-GPG-KEY-google-linux
COPY image/repos/tailscale.repo /etc/yum.repos.d/tailscale.repo
COPY image/keys/tailscale.asc /etc/pki/rpm-gpg/RPM-GPG-KEY-tailscale
RUN dnf install -y --enable-repo=google-chrome --enable-repo=tailscale-stable --setopt=install_weak_deps=False $(cat /tmp/zeus-packages.txt) && \
    dnf clean all && rm -f /tmp/zeus-packages.txt /etc/cron.daily/google-chrome && \
    printf 'repo_add_once="false"\n' > /etc/default/google-chrome
# Vendor RPMs can configure their own repositories. Keep only the verified,
# restricted, disabled build repositories; the running immutable OS receives
# Chrome and Tailscale upgrades through signed Zeus Updates.
COPY image/repos/google-chrome.repo /etc/yum.repos.d/google-chrome.repo
COPY image/repos/tailscale.repo /etc/yum.repos.d/tailscale.repo

FROM desktop-base AS codex-package
COPY image/codex.lock.json /tmp/codex.lock.json
COPY scripts/install-codex.py /tmp/install-codex.py
RUN python3 /tmp/install-codex.py --lock /tmp/codex.lock.json --destination /usr/lib/codex

FROM ${BASE_IMAGE} AS cli-builder
RUN dnf install -y --setopt=install_weak_deps=False cargo rust gcc && dnf clean all
ENV CARGO_HOME=/tmp/cargo
WORKDIR /src/zeus
COPY zeus/Cargo.toml zeus/Cargo.lock ./
COPY zeus/src ./src
RUN cargo test --locked --offline && cargo build --release --locked --offline

FROM desktop-base AS branding-builder
RUN dnf install -y --setopt=install_weak_deps=False glib2-devel && dnf clean all
COPY desktop/rootfs/usr/share/zeus/ /usr/share/zeus/
COPY scripts/build-greeter-theme.py /tmp/build-greeter-theme.py
RUN python3 /tmp/build-greeter-theme.py

FROM desktop-base
ARG VERSION=0.1.0-preview.2
ARG SOURCE_COMMIT=unknown
ARG BUILD_ID=development
ARG UPDATE_SEQUENCE=0
LABEL org.opencontainers.image.title="Zeus OS" \
      org.opencontainers.image.description="A focused, beautiful laptop desktop. First preview." \
      org.opencontainers.image.source="https://github.com/KanterLabs/zeusos" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      dev.kanterlabs.zeus.build-id="${BUILD_ID}" \
      dev.kanterlabs.zeus.update-sequence="${UPDATE_SEQUENCE}"
COPY desktop/rootfs/ /
COPY image/rootfs/ /
COPY --from=branding-builder /usr/share/gnome-shell/gnome-shell-theme.gresource /usr/share/gnome-shell/gnome-shell-theme.gresource
COPY --from=cli-builder /src/zeus/target/release/zeus /usr/bin/zeus
COPY --from=codex-package /usr/lib/codex /usr/lib/codex
COPY image/codex.lock.json /usr/share/zeus/codex.lock.json
COPY image/licenses/codex/ /usr/share/licenses/zeus-codex/
COPY zeus/assets/welcome.py /usr/libexec/zeus-welcome
COPY zeus/assets/org.zeus.Welcome.desktop /usr/share/applications/org.zeus.Welcome.desktop
COPY image/inputs.json /usr/share/zeus/inputs.json
COPY developer-mode/components.json /usr/share/zeus/developer-components.json
COPY security/allowed_signers /usr/share/zeus/update-allowed-signers
COPY security/developer_allowed_signers /usr/share/zeus/developer-allowed-signers
COPY scripts/validate-bluetooth-audio.py /tmp/zeus-validate-bluetooth-audio.py
COPY scripts/validate-browser.py /tmp/zeus-validate-browser.py
COPY scripts/validate-codex.py /tmp/zeus-validate-codex.py
COPY scripts/validate-wifi.py /tmp/zeus-validate-wifi.py
# Foreign-architecture build emulators register dozens of binfmt handlers at
# every boot. They are optional development tools, not laptop runtime packages.
RUN dnf remove -y --disable-repo='*' 'qemu-user-static*' && \
    test -x /usr/bin/systemd-sysext && \
    test -x /usr/bin/ssh-keygen && \
    test -x /usr/bin/mount && \
    test -x /usr/bin/umount && \
    ln -s /usr/lib/codex/bin/codex /usr/bin/codex && \
    python3 /tmp/zeus-validate-codex.py && \
    python3 /tmp/zeus-validate-bluetooth-audio.py --load-plugins --json && \
    python3 /tmp/zeus-validate-browser.py && \
    python3 /tmp/zeus-validate-wifi.py --json && \
    rm /tmp/zeus-validate-bluetooth-audio.py /tmp/zeus-validate-browser.py /tmp/zeus-validate-codex.py /tmp/zeus-validate-wifi.py && \
    chmod 0644 /usr/share/backgrounds/zeus/zeus-city-new-york-dusk.png /usr/share/gnome-background-properties/zeus.xml && \
    chmod 0644 /usr/share/gnome-shell/extensions/zeus-lock-background@kanterlabs/extension.js /usr/share/gnome-shell/extensions/zeus-lock-background@kanterlabs/metadata.json && \
    chmod 0755 /usr/libexec/zeus-welcome /usr/libexec/zeus-settings-window && \
    chmod 0755 /usr/libexec/zeus-browser-session && \
    chmod 0755 /usr/libexec/zeus-tailscale /usr/libexec/zeus-tailscale-admin && \
    chmod 0644 /usr/lib/zeus/tailscale_control.py /usr/share/polkit-1/actions/org.zeus.Tailscale.policy && \
    find /usr/libexec -maxdepth 1 -type f -name 'zeus-developer*' -exec chmod 0755 {} + && \
    find /usr/lib/zeus -maxdepth 1 -type f -name 'developer*' -exec chmod 0644 {} + && \
    find /usr/share/polkit-1/actions -maxdepth 1 -type f -iname '*developer*.policy' -exec chmod 0644 {} + && \
    find /usr/lib/tmpfiles.d -maxdepth 1 -type f -iname '*developer*.conf' -exec chmod 0644 {} + && \
    find /usr/lib/systemd/system -maxdepth 1 -type f -iname '*developer*.service' -exec chmod 0644 {} + && \
    chmod 0644 /etc/xdg/autostart/zeus-browser.desktop /etc/xdg/mimeapps.list /etc/opt/chrome/policies/recommended/zeus.json && \
    chmod 0644 /usr/lib/zeus/settings_model.py /usr/share/applications/org.zeus.Settings.desktop /usr/share/icons/hicolor/scalable/apps/org.zeus.Settings.svg && \
    chmod 0644 /usr/share/zeus/developer-components.json /usr/share/zeus/update-allowed-signers /usr/share/zeus/developer-allowed-signers && \
    glib-compile-schemas /usr/share/gnome-shell/extensions/zeus-shell@kanterlabs/schemas && \
    dconf update && \
    systemd-hwdb update --usr && \
    gtk-update-icon-cache --force --ignore-theme-index /usr/share/icons/hicolor && \
    gtk-update-icon-cache --force --ignore-theme-index /usr/share/icons/Zeus && \
    systemctl set-default graphical.target && \
    systemctl disable nfs-client.target && \
    systemctl enable gdm.service NetworkManager.service firewalld.service sshd.service power-profiles-daemon.service tailscaled.service && \
    systemctl enable cloud-init-local.service cloud-init-network.service cloud-init-main.service cloud-config.service cloud-final.service && \
    systemctl mask bootc-fetch-apply-updates.timer && \
    systemctl enable zeus-tmpfiles.service zeus-temp-inspector.socket zeus-developer-activate.service && \
    mkdir -p /usr/share/zeus && \
    rpm -qa --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > /usr/share/zeus/packages.lock && \
    printf '%s\n' "${VERSION}" > /usr/share/zeus/version && \
    printf '%s\n' "${SOURCE_COMMIT}" > /usr/share/zeus/source-commit && \
    printf '%s\n' "${BUILD_ID}" > /usr/share/zeus/build-id && \
    printf '%s\n' "${UPDATE_SEQUENCE}" > /usr/share/zeus/update-sequence && \
    case "${BUILD_ID}" in \
      ''|*[!a-z0-9._-]*) echo 'BUILD_ID must contain only lowercase letters, numbers, dots, underscores, and hyphens.' >&2; exit 1 ;; \
    esac && \
    if grep -q '^SYSEXT_LEVEL=' /usr/lib/os-release; then \
      sed -i "s|^SYSEXT_LEVEL=.*$|SYSEXT_LEVEL=${BUILD_ID}|" /usr/lib/os-release; \
    else \
      printf 'SYSEXT_LEVEL=%s\n' "${BUILD_ID}" >> /usr/lib/os-release; \
    fi && \
    sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="Zeus OS 0.1 Preview"/' /usr/lib/os-release && \
    bootc container lint
