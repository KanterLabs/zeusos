# Zeus OS GNOME 50 first-preview defaults.
#
# These are defaults in system-db:local, not locks. A user's dconf database
# remains writable and takes precedence, so reduced-motion, scaling, theme,
# input, and accessibility choices remain user-controlled.

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/zeus/zeus-city-new-york-dusk.png'
picture-uri-dark='file:///usr/share/backgrounds/zeus/zeus-city-new-york-dusk.png'
picture-options='zoom'
color-shading-type='solid'
primary-color='#0B1534'
secondary-color='#233D86'

[org/gnome/desktop/interface]
color-scheme='prefer-light'
icon-theme='Zeus'
accent-color='blue'
font-name='Adwaita Sans 11'
document-font-name='Adwaita Sans 12'
monospace-font-name='Adwaita Mono 11'
clock-format='24h'
clock-show-date=true
clock-show-seconds=false
clock-show-weekday=false
show-battery-percentage=true
enable-hot-corners=false

[org/gnome/desktop/wm/preferences]
# CSD applications may keep their own header-bar layout; this applies where
# the window manager owns the decorations.
button-layout='close,minimize,maximize:'

[org/gnome/desktop/wm/keybindings]
# Zeus Shell owns Super+Space for application search. Keep the native search
# list empty so two handlers do not compete for the same accelerator.
switch-input-source=['<Super><Alt>space', 'XF86Keyboard']
switch-input-source-backward=['<Shift><Super><Alt>space', '<Shift>XF86Keyboard']

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'zeus-shell@kanterlabs', 'zeus-lock-background@kanterlabs', 'codex-usage@kanterlabs']
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Ptyxis.desktop', 'google-chrome.desktop', 'org.gnome.Settings.desktop', 'org.zeus.Temp.desktop', 'org.zeus.Welcome.desktop']

[org/gnome/shell/extensions/dash-to-dock]
# Keep the dock fixed and present during normal work for predictable targets;
# the existing fullscreen-only hide remains the sole visibility exception.
disable-overview-on-startup=true
dock-position='BOTTOM'
dock-fixed=true
extend-height=false
intellihide=false
intellihide-mode='FOCUS_APPLICATION_WINDOWS'
autohide=false
require-pressure-to-show=false
autohide-in-fullscreen=true
dash-max-icon-size=48
icon-size-fixed=true
show-running=true
running-indicator-style='DOT'
running-indicator-dominant-color=false
show-favorites=true
show-show-apps-button=false
show-trash=false
show-mounts=false
show-windows-preview=true
click-action='focus-or-previews'
scroll-action='cycle-windows'
scroll-switch-workspace=true
isolate-workspaces=false
isolate-monitors=false
show-dock-urgent-notify=true
transparency-mode='DEFAULT'
custom-background-color=false
background-color='#101A36'
background-opacity=0.86
apply-custom-theme=false

[org/gnome/settings-daemon/plugins/media-keys]
# These defaults launch native applications through gnome-settings-daemon.
# Shortcuts can be customized in Settings, and existing personal settings
# remain preserved when the defaults are applied.
search=@as []
on-screen-keyboard=['<Super><Alt>k']
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/zeus-files/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/zeus-temp/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/zeus-terminal/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/zeus-files]
name='Zeus Files'
command='/usr/bin/nautilus'
binding='<Super>e'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/zeus-temp]
name='Zeus Temp'
command='/usr/libexec/zeus-temp-window'
binding='<Super><Shift>t'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/zeus-terminal]
name='Zeus Terminal'
command='/usr/bin/ptyxis'
binding='<Super>Return'

[org/gnome/desktop/notifications]
# Notification banners remain available after unlock, but their contents are
# never rendered on the lock screen.
show-in-lock-screen=false

[org/gnome/desktop/privacy]
show-full-name-in-top-bar=false

[org/gnome/desktop/screensaver]
lock-enabled=true
lock-delay=0
show-full-name-in-top-bar=false
picture-uri='file:///usr/share/backgrounds/zeus/zeus-city-new-york-dusk.png'
picture-options='zoom'
color-shading-type='solid'
primary-color='#081127'
secondary-color='#1C2D70'
