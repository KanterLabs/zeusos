# Zeus OS GNOME 50 first-preview defaults.
#
# These are defaults in system-db:local, not locks. A user's dconf database
# remains writable and takes precedence, so reduced-motion, scaling, theme,
# input, and accessibility choices remain user-controlled.

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/zeus/zeus-wallpaper-light.svg'
picture-uri-dark='file:///usr/share/backgrounds/zeus/zeus-wallpaper-dark.svg'
picture-options='zoom'
color-shading-type='solid'
primary-color='#0B1534'
secondary-color='#233D86'

[org/gnome/desktop/interface]
color-scheme='prefer-light'
icon-theme='Zeus'
accent-color='blue'
font-name='Adwaita Sans 11'
document-font-name='Adwaita Sans 12'
monospace-font-name='Adwaita Mono 11'
clock-format='24h'
clock-show-date=true
clock-show-seconds=false
clock-show-weekday=false
show-battery-percentage=true
enable-hot-corners=false

[org/gnome/desktop/wm/preferences]
# CSD applications may keep their own header-bar layout; this applies where
# the window manager owns the decorations.
button-layout='close,minimize,maximize:'

[org/gnome/desktop/wm/keybindings]
# Reserve Super+Space for the native GNOME search action while retaining
# keyboard-layout switching through the hardware key and an alternate chord.
switch-input-source=['<Super><Alt>space', 'XF86Keyboard']
switch-input-source-backward=['<Shift><Super><Alt>space', '<Shift>XF86Keyboard']

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'zeus-shell@kanterlabs']
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Ptyxis.desktop', 'org.mozilla.firefox.desktop', 'org.gnome.Settings.desktop', 'org.zeus.Welcome.desktop']

[org/gnome/shell/extensions/dash-to-dock]
disable-overview-on-startup=true
dock-position='BOTTOM'
dock-fixed=false
extend-height=false
intellihide=true
intellihide-mode='FOCUS_APPLICATION_WINDOWS'
autohide=true
require-pressure-to-show=false
autohide-in-fullscreen=true
dash-max-icon-size=48
icon-size-fixed=true
show-running=true
running-indicator-style='DOT'
running-indicator-dominant-color=false
show-favorites=true
show-show-apps-button=false
show-trash=false
show-mounts=false
show-windows-preview=true
click-action='focus-or-previews'
scroll-action='cycle-windows'
scroll-switch-workspace=true
isolate-workspaces=false
isolate-monitors=false
show-dock-urgent-notify=true
transparency-mode='FIXED'
custom-background-color=true
background-color='#101A36'
background-opacity=0.86
apply-custom-theme=false

[org/gnome/settings-daemon/plugins/media-keys]
# gnome-settings-daemon dispatches this through GNOME Shell's supported
# FocusSearch D-Bus action. It avoids a custom search implementation.
search=[]
on-screen-keyboard=['<Super><Alt>k']
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/zeus-terminal/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/zeus-terminal]
name='Zeus Terminal'
command='/usr/bin/ptyxis'
binding='<Super>Return'

[org/gnome/desktop/notifications]
# Notification banners remain available after unlock, but their contents are
# never rendered on the lock screen.
show-in-lock-screen=false

[org/gnome/desktop/privacy]
show-full-name-in-top-bar=false

[org/gnome/desktop/screensaver]
lock-enabled=true
lock-delay=0
show-full-name-in-top-bar=false
picture-uri='file:///usr/share/backgrounds/zeus/zeus-wallpaper-dark.svg'
picture-options='zoom'
color-shading-type='solid'
primary-color='#081127'
secondary-color='#1C2D70'
