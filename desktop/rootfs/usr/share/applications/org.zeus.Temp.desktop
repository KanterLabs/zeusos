[Desktop Entry]
Type=Application
Name=Temp
GenericName=Temporary files
Comment=Manage temporary downloads and cleanup
Exec=/usr/libexec/zeus-temp-window
Icon=org.zeus.Temp
Terminal=false
Categories=GTK;GNOME;Utility;FileManager;
Keywords=temporary;downloads;cleanup;
StartupNotify=true
Actions=OpenInFiles;

[Desktop Action OpenInFiles]
Name=Open in Files
Exec=/usr/libexec/zeus-temp-window --open-in-files
