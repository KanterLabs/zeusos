#!/usr/bin/env python3
"""Arm the owner-scoped Zeus Temp cleanup timer.

The cleanup policy is persisted by :mod:`zeus_temp`; this helper only turns a
persisted timed deadline into a one-shot user systemd timer.  Boot and Never
policies deliberately leave no armed timer behind.  It is safe to invoke
``arm`` after setup, after a policy change, and after each sweep.
"""

from __future__ import annotations

import argparse
import contextlib
import datetime as datetime_module
import fcntl
import json
import math
import os
import pwd
import stat
import subprocess
import tempfile
from pathlib import Path
from typing import Any, Callable, Mapping, Sequence


try:
    from zeus import zeus_temp
except ImportError:
    # The repository runs this file from the rootfs overlay before it is
    # installed.  The installed image exposes the package under /usr/lib.
    import sys

    sys.path.insert(0, "/usr/lib")
    try:
        from zeus import zeus_temp
    except ImportError:
        sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
        from zeus import zeus_temp


TIMER_UNIT = "zeus-temp-clean.timer"
DROPIN_NAME = "10-zeus-deadline.conf"
ARMED_MARKER = "zeus-temp-clean.armed"
LOCK_FILE = "zeus-temp-clean.lock"
SYSTEMCTL = "/usr/bin/systemctl"


class SchedulerError(RuntimeError):
    """A user-systemd timer could not be updated safely."""


def _owner_home() -> Path:
    try:
        return Path(pwd.getpwuid(os.getuid()).pw_dir).resolve(strict=False)
    except (KeyError, OSError):
        return Path.home().resolve(strict=False)


def _default_config_home(home: Path) -> Path:
    configured = os.environ.get("XDG_CONFIG_HOME")
    if configured:
        candidate = Path(configured)
        if candidate.is_absolute():
            return candidate
    return home / ".config"


def _default_runtime_dir() -> Path:
    configured = os.environ.get("XDG_RUNTIME_DIR")
    if configured:
        candidate = Path(configured)
        if candidate.is_absolute():
            return candidate
    return Path(f"/run/user/{os.getuid()}")


def _calendar_timestamp(value: Any) -> str:
    try:
        deadline = float(value)
    except (TypeError, ValueError, OverflowError):
        raise SchedulerError("cleanup deadline is not a timestamp") from None
    if not math.isfinite(deadline) or deadline < 0:
        raise SchedulerError("cleanup deadline is invalid")
    if deadline.is_integer():
        return str(int(deadline))
    return format(deadline, ".6f").rstrip("0").rstrip(".")


def _calendar_spec(value: Any) -> str:
    """Return a systemd calendar event with sub-second precision when needed."""

    timestamp = _calendar_timestamp(value)
    if "." not in timestamp:
        return f"@{timestamp}"
    try:
        moment = datetime_module.datetime.fromtimestamp(float(value), tz=datetime_module.timezone.utc)
    except (OverflowError, OSError, ValueError) as error:
        raise SchedulerError(f"cleanup deadline is invalid: {error}") from error
    return moment.strftime("%Y-%m-%d %H:%M:%S.%f UTC")


def _default_systemctl(arguments: Sequence[str]) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            [SYSTEMCTL, "--user", *arguments],
            check=False,
            capture_output=True,
            text=True,
            timeout=20,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise SchedulerError(f"cannot invoke user systemd: {error}") from error


Systemctl = Callable[[Sequence[str]], subprocess.CompletedProcess[str]]


class TimerScheduler:
    """Synchronize the static user timer with the persisted Temp deadline."""

    def __init__(
        self,
        *,
        home: os.PathLike[str] | str | None = None,
        config_home: os.PathLike[str] | str | None = None,
        runtime_dir: os.PathLike[str] | str | None = None,
        schedule_source: Callable[[], Mapping[str, Any]] | None = None,
        sweep_source: Callable[[], Mapping[str, Any]] | None = None,
        systemctl: Systemctl | None = None,
    ) -> None:
        self.home = Path(home).resolve(strict=False) if home is not None else _owner_home()
        self.config_home = (
            Path(config_home).resolve(strict=False)
            if config_home is not None
            else _default_config_home(self.home)
        )
        self.runtime_dir = (
            Path(runtime_dir).resolve(strict=False)
            if runtime_dir is not None
            else _default_runtime_dir()
        )
        self.dropin_dir = self.config_home / "systemd" / "user" / f"{TIMER_UNIT}.d"
        self.dropin_path = self.dropin_dir / DROPIN_NAME
        self.marker_path = self.runtime_dir / ARMED_MARKER
        self.lock_path = self.runtime_dir / LOCK_FILE
        self.schedule_source = schedule_source or zeus_temp.schedule
        # The timer only needs the sweep result and persisted next deadline.
        # Avoid a second full Temp walk to build the human-facing usage
        # snapshot; the interactive status API keeps its established default.
        self.sweep_source = sweep_source or (
            lambda: zeus_temp.sweep(include_usage=False, synchronize_timer=False)
        )
        self.systemctl = systemctl or _default_systemctl

    @contextlib.contextmanager
    def _lock(self):
        """Serialize timer file and systemd side effects per owner."""

        try:
            self.runtime_dir.mkdir(parents=True, exist_ok=True)
            fd = os.open(
                self.lock_path,
                os.O_RDWR | os.O_CREAT | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
                0o600,
            )
        except OSError as error:
            raise SchedulerError(f"cannot open timer scheduler lock: {error}") from error
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            yield
        finally:
            with contextlib.suppress(OSError):
                fcntl.flock(fd, fcntl.LOCK_UN)
            os.close(fd)

    def _call_systemctl(self, arguments: Sequence[str], *, allow_not_found: bool = False) -> None:
        result = self.systemctl(arguments)
        if result.returncode == 0:
            return
        if allow_not_found and result.returncode in (4, 5):
            return
        detail = (result.stderr or result.stdout or "").strip()
        suffix = f": {detail}" if detail else ""
        raise SchedulerError(f"systemctl --user {' '.join(arguments)} failed{suffix}")

    def _stop_timer(self) -> None:
        self._call_systemctl(("stop", TIMER_UNIT), allow_not_found=True)

    def _daemon_reload(self) -> None:
        self._call_systemctl(("daemon-reload",))

    def _start_timer(self) -> None:
        self._call_systemctl(("start", TIMER_UNIT))

    @staticmethod
    def _write_atomic(path: Path, payload: str, *, mode: int = 0o600) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        fd: int | None = None
        temporary_name: str | None = None
        try:
            fd, temporary_name = tempfile.mkstemp(
                prefix=f".{path.name}.",
                suffix=".tmp",
                dir=path.parent,
            )
        except OSError as error:
            raise SchedulerError(f"cannot create timer configuration: {error}") from error
        try:
            os.fchmod(fd, mode)
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                fd = None
                stream.write(payload)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary_name, path)
        except OSError as error:
            raise SchedulerError(f"cannot write timer configuration: {error}") from error
        finally:
            if fd is not None:
                with contextlib.suppress(OSError):
                    os.close(fd)
            if temporary_name is not None:
                with contextlib.suppress(OSError):
                    os.unlink(temporary_name)

    def _write_deadline(self, deadline: Any, *, due: bool = False) -> None:
        if due:
            _calendar_timestamp(deadline)
            # systemd does not replay an absolute calendar event that is
            # already in the past when a freshly started timer has no prior
            # activation stamp.  Use a one-second monotonic catch-up trigger;
            # the backend still owns the persisted deadline and will decide
            # whether the sweep is due.
            payload = (
                "[Timer]\n"
                "# Catch up the persisted deadline after manager restart.\n"
                "OnCalendar=\n"
                "OnActiveSec=\n"
                "OnActiveSec=1s\n"
            )
        else:
            payload = (
                "[Timer]\n"
                "# Replace the dormant baseline event with this one-shot deadline.\n"
                "OnCalendar=\n"
                "OnActiveSec=\n"
                f"OnCalendar={_calendar_spec(deadline)}\n"
            )
        self._write_atomic(self.dropin_path, payload)

    def _write_marker(self, deadline: Any) -> None:
        timestamp = _calendar_timestamp(deadline)
        self.runtime_dir.mkdir(parents=True, exist_ok=True)
        flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_CLOEXEC", 0)
        flags |= getattr(os, "O_NOFOLLOW", 0)
        try:
            fd = os.open(self.marker_path, flags, 0o600)
        except OSError as error:
            raise SchedulerError(f"cannot create timer marker: {error}") from error
        try:
            os.fchmod(fd, 0o600)
            payload = (timestamp + "\n").encode("ascii")
            view = memoryview(payload)
            while view:
                count = os.write(fd, view)
                view = view[count:]
            os.fsync(fd)
        except OSError as error:
            raise SchedulerError(f"cannot write timer marker: {error}") from error
        finally:
            os.close(fd)

    @staticmethod
    def _remove_file(path: Path) -> bool:
        try:
            value = path.lstat()
        except FileNotFoundError:
            return False
        if stat.S_ISDIR(value.st_mode):
            raise SchedulerError(f"timer path is a directory: {path.name}")
        try:
            path.unlink()
        except OSError as error:
            raise SchedulerError(f"cannot remove {path.name}: {error}") from error
        return True

    def _disarm_locked(self) -> None:
        errors: list[str] = []
        try:
            self._stop_timer()
        except SchedulerError as error:
            errors.append(str(error))
        changed = False
        for path in (self.dropin_path, self.marker_path):
            try:
                changed = self._remove_file(path) or changed
            except SchedulerError as error:
                errors.append(str(error))
        if changed:
            try:
                self._daemon_reload()
            except SchedulerError as error:
                errors.append(str(error))
        if errors:
            raise SchedulerError("; ".join(errors))

    def _arm_locked(self, info: Mapping[str, Any] | None = None) -> dict[str, Any]:
        """Apply the current schedule and report whether a timer is armed."""

        if info is None:
            info = self.schedule_source()
        if not isinstance(info, Mapping):
            raise SchedulerError("Temp schedule query returned an invalid response")
        result = dict(info)
        if info.get("ok") is not True:
            try:
                self._disarm_locked()
            except SchedulerError as error:
                result["scheduler_error"] = str(error)
                result["ok"] = False
            result["timer_armed"] = False
            return result
        if not info.get("scheduled"):
            self._disarm_locked()
            result["timer_armed"] = False
            return result

        deadline = info.get("next_cleanup_at")
        # Validate before stopping a previously valid timer.  A malformed or
        # unsupported state therefore cannot turn a healthy schedule into a
        # busy retry loop.
        _calendar_timestamp(deadline)
        try:
            self._stop_timer()
            self._write_deadline(deadline, due=bool(info.get("due")))
            self._write_marker(deadline)
            self._daemon_reload()
            self._start_timer()
        except Exception as error:
            # A failed update must not leave a marker or drop-in that can
            # resurrect a stale deadline at the next session.  Preserve the
            # original failure while making a best-effort disarm visible.
            try:
                self._disarm_locked()
            except Exception as cleanup_error:
                raise SchedulerError(
                    f"cannot arm cleanup timer: {error}; disarm failed: {cleanup_error}"
                ) from error
            if isinstance(error, SchedulerError):
                raise
            raise SchedulerError(f"cannot arm cleanup timer: {error}") from error
        result.update({"timer_armed": True, "timer_unit": TIMER_UNIT})
        return result

    def arm(self, info: Mapping[str, Any] | None = None) -> dict[str, Any]:
        """Apply the current schedule and report whether a timer is armed."""

        with self._lock():
            # Query the backend only after taking the scheduler lock.  A
            # concurrent policy change cannot be followed by a stale timer
            # side effect from an older arm caller.
            return self._arm_locked(info)

    @staticmethod
    def _sweep_summary(result: Mapping[str, Any]) -> dict[str, Any]:
        """Keep timer-service output useful without logging Temp names."""

        skipped = result.get("skipped")
        errors = result.get("errors")
        summary: dict[str, Any] = {
            "ok": bool(result.get("ok")),
            "swept": bool(result.get("swept")),
            "reason": result.get("reason"),
            "deleted": int(result.get("deleted", 0) or 0),
            "deleted_bytes": int(result.get("deleted_bytes", 0) or 0),
            "skipped_count": len(skipped) if isinstance(skipped, list) else 0,
            "error_count": len(errors) if isinstance(errors, list) else 0,
        }
        if result.get("retry_required"):
            summary["retry_required"] = True
        if result.get("error_type"):
            summary["error_type"] = str(result["error_type"])
        return summary

    def run(self) -> dict[str, Any]:
        """Sweep once, then rearm from the backend's newly persisted state."""

        with self._lock():
            sweep_failed = False
            try:
                sweep_result = self.sweep_source()
                if not isinstance(sweep_result, Mapping):
                    raise SchedulerError("Temp sweep returned an invalid response")
                sweep_result = dict(sweep_result)
            except Exception as error:  # backend errors must still disarm stale timers
                sweep_failed = True
                sweep_result = {
                    "ok": False,
                    "swept": False,
                    "error_type": type(error).__name__,
                }
            try:
                # An unexpected sweep exception may leave the persisted
                # deadline due.  Leave the one-shot disarmed so a crash or
                # transient backend failure cannot become a rapid timer retry
                # loop; the next session startup can perform catch-up.
                if sweep_failed:
                    self._disarm_locked()
                    schedule_result = {"ok": False, "timer_armed": False, "reason": "sweep-error"}
                else:
                    schedule_result = self._arm_locked()
            except Exception as error:
                # This also covers an unexpected backend schedule failure.
                # Remove any stale one-shot state before reporting the error
                # so a failed arm cannot cause repeated wakeups.
                try:
                    self._disarm_locked()
                except Exception as cleanup_error:
                    schedule_result = {
                        "ok": False,
                        "timer_armed": False,
                        "error": str(error),
                        "error_type": type(error).__name__,
                        "scheduler_error": str(cleanup_error),
                    }
                else:
                    schedule_result = {
                        "ok": False,
                        "timer_armed": False,
                        "error": str(error),
                        "error_type": type(error).__name__,
                    }
            return {
                "ok": bool(sweep_result.get("ok")) and bool(schedule_result.get("ok")),
                "sweep": self._sweep_summary(sweep_result),
                "schedule": schedule_result,
            }


def _print_json(value: Mapping[str, Any]) -> None:
    print(json.dumps(value, sort_keys=True, indent=2, default=str))


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Arm the Zeus Temp cleanup timer")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("arm", help="synchronize the one-shot timer with policy state")
    subparsers.add_parser("run", help="sweep once and rearm the one-shot timer")
    args = parser.parse_args(argv)
    scheduler = TimerScheduler()
    try:
        result = scheduler.arm() if args.command == "arm" else scheduler.run()
    except Exception as error:
        _print_json({"ok": False, "error": str(error), "error_type": type(error).__name__})
        return 1
    _print_json(result)
    return 0 if result.get("ok") else 1


if __name__ == "__main__":
    raise SystemExit(main())
