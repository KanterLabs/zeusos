#!/usr/bin/env python3
"""Native GTK window for the Zeus temporary-download folder.

The cleanup engine owns all filesystem policy and mutation.  This process only
renders the engine's JSON-friendly results and submits explicit user actions
to it.  Backend calls run on a single worker so a slow filesystem operation
never stalls the GTK main loop.
"""

from __future__ import annotations

import concurrent.futures
import datetime as datetime_module
import os
from pathlib import Path
import sys
from typing import Any, Callable, Mapping

import gi

gi.require_version("Adw", "1")
gi.require_version("Gtk", "4.0")
from gi.repository import Adw, Gio, GLib, Gtk, Pango


BACKEND_PATH = "/usr/lib/zeus"
if BACKEND_PATH not in sys.path:
    sys.path.insert(0, BACKEND_PATH)

try:
    import zeus_temp as temp_backend
except Exception as error:  # pragma: no cover - exercised on incomplete images
    temp_backend = None
    BACKEND_IMPORT_ERROR = error
else:
    BACKEND_IMPORT_ERROR = None


APPLICATION_ID = "org.zeus.Temp"
MIN_CUSTOM_MINUTES = 15
MAX_CUSTOM_MINUTES = 365 * 24 * 60

POLICIES = (
    ("boot", "On boot"),
    ("hourly", "Every hour"),
    ("daily", "Every day"),
    ("weekly", "Every week"),
    ("custom", "Custom interval"),
    ("never", "Never"),
)
POLICY_LABELS = {mode: label for mode, label in POLICIES}
POLICY_ALIASES = {
    "on_boot": "boot",
    "boot_once": "boot",
    "onboot": "boot",
    "hour": "hourly",
    "every_hour": "hourly",
    "day": "daily",
    "every_day": "daily",
    "week": "weekly",
    "every_week": "weekly",
    "manual": "never",
    "disabled": "never",
    "off": "never",
}


