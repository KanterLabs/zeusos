#!/usr/bin/env python3
"""Native Zeus Settings home for the controls people use every day.

Zeus keeps hardware policy in Fedora's supported GNOME stack.  This window is
only a compact, accessible directory for those native panels plus the existing
Temp and Updates tools.  Panel launches use fixed desktop IDs or fixed argv
arrays, and the one hardware snapshot is read-only and taken during open.
"""

from __future__ import annotations

import sys
from typing import Any

import gi

gi.require_version("Adw", "1")
gi.require_version("Gtk", "4.0")
from gi.repository import Adw, Gio, GLib, Gtk, Pango


MODEL_PATH = "/usr/lib/zeus"
if MODEL_PATH not in sys.path:
    sys.path.insert(0, MODEL_PATH)

import settings_model


APPLICATION_ID = "org.zeus.Settings"
NATIVE_SETTINGS_DESKTOP_ID = "org.gnome.Settings.desktop"
GNOME_CONTROL_CENTER_COMMAND = "/usr/bin/gnome-control-center"


CSS = """
