def _label(
    text: str,
    css_class: str,
    *,
    wrap: bool = False,
    max_width_chars: int | None = None,
) -> Gtk.Label:
    label = Gtk.Label(label=text)
    label.set_xalign(0)
    label.add_css_class(css_class)
    if wrap:
        label.set_wrap(True)
        label.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
        # Measure wrapped copy by its minimum width. This prevents long detail
        # text from forcing a compact or 200%-scaled window wider than the
        # available display before the responsive breakpoint can collapse.
        natural_wrap_mode = getattr(Gtk, "NaturalWrapMode", None)
        if natural_wrap_mode is not None:
            label.set_natural_wrap_mode(natural_wrap_mode.NONE)
        label.set_hexpand(True)
        if max_width_chars is not None:
            label.set_max_width_chars(max_width_chars)
    return label


def _row_title(text: str) -> Gtk.Label:
    """Return a title that yields space instead of widening compact pages."""

    label = _label(text, "setting-row-title")
    label.set_hexpand(True)
    label.set_width_chars(1)
    label.set_max_width_chars(42)
    label.set_ellipsize(Pango.EllipsizeMode.END)
    label.set_tooltip_text(text)
    return label


def _safe_hardware_snapshot() -> settings_model.HardwareState:
    """Return an honest unknown state if sysfs cannot be read at startup."""

    try:
        return settings_model.discover_hardware()
    except (OSError, RuntimeError, TypeError, ValueError):
        return settings_model.HardwareState(None, None, None, None)


class SettingsWindow(Adw.ApplicationWindow):
    """The Zeus-owned navigation surface for system and local settings."""

    def __init__(
        self,
        application: Adw.Application,
        requested_page: str = settings_model.DEFAULT_PAGE,
    ):
        super().__init__(application=application, title="Settings")
        self.set_default_size(1040, 720)
        self.set_size_request(520, 500)
        self.add_css_class("zeus-window")
        self._closed = False
        self._hardware = _safe_hardware_snapshot()
        self._version, self._build_id = settings_model.read_build_identity()
        self._developer_status = settings_model.default_developer_status()
        self._developer_status_in_flight = False
        self._developer_action_in_flight = False
        self._developer_action: str | None = None
        self._developer_process = None
        self._developer_cancellable = None
        self._developer_notice = ""
        self._developer_notice_kind = "info"
        self._developer_preserve_notice = False
        self._wifi_controller = None
        self._bluetooth_controller = None
        self._wifi_rendering = False
        self._bluetooth_rendering = False
        self._sidebar_buttons: dict[str, Gtk.Button] = {}
        self._page_headings: dict[str, Gtk.Widget] = {}
        self._page_history: list[str] = []
        self._page = settings_model.DEFAULT_PAGE
        self._requested_page = settings_model.normalize_page(requested_page)

        self._install_css()
        self._build_window()
        self._wifi_controller = settings_connectivity.WifiController(
            self._render_wifi, self._show_toast
        )
        self._bluetooth_controller = settings_connectivity.BluetoothController(
            self._render_bluetooth,
            self._show_toast,
            self._show_bluetooth_pairing_prompt,
        )
        self._wifi_controller.start()
        self._bluetooth_controller.start()
        self.show_page(self._requested_page)
        # The helper is queried once when the window opens.  Later reads happen
        # after an explicit action or when the window becomes active; there is
        # no timer or background polling while Settings is idle.
        self._request_developer_status()
        # Hardware can change while the window is open (for example after a
        # dock or adapter is connected).  Refresh only on an activation signal;
        # there is no timer or background watcher while Settings is idle.
        self.connect("notify::is-active", self._on_active_changed)

    def _install_css(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode("utf-8"))
        display = self.get_display()
        if display is not None:
            Gtk.StyleContext.add_provider_for_display(
                display,
                provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )

    @staticmethod
    def _set_accessible_label(widget: Gtk.Widget, label: str):
        accessible_property = getattr(Gtk, "AccessibleProperty", None)
        update_property = getattr(widget, "update_property", None)
        if accessible_property is not None and update_property is not None:
            try:
                update_property([accessible_property.LABEL], [label])
                return
            except (AttributeError, TypeError, ValueError):
                pass
        try:
            widget.set_tooltip_text(label)
        except (AttributeError, RuntimeError):
            pass

    @staticmethod
    def _set_accessible_role(widget: Gtk.Widget, role_name: str):
        role = getattr(getattr(Gtk, "AccessibleRole", None), role_name, None)
        setter = getattr(widget, "set_accessible_role", None)
        if role is not None and callable(setter):
            try:
                setter(role)
            except (AttributeError, RuntimeError, TypeError, ValueError):
                pass

    @staticmethod
    def _set_accessible_selected(widget: Gtk.Widget, selected: bool):
        state = getattr(getattr(Gtk, "AccessibleState", None), "SELECTED", None)
        update = getattr(widget, "update_state", None)
        if state is not None and callable(update):
            try:
                tristate = getattr(Gtk, "AccessibleTristate", None)
                value = (
                    int(tristate.TRUE if selected else tristate.FALSE)
                ) if tristate is not None else bool(selected)
                update([state], [value])
            except (AttributeError, RuntimeError, TypeError, ValueError):
                pass

    def _page_heading(self, page: str, text: str, css_class: str) -> Gtk.Label:
        label = _label(text, css_class)
        label.set_focusable(True)
        self._set_accessible_role(label, "HEADING")
        self._page_headings[page] = label
        return label

    def _build_window(self):
        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        # Let libadwaita provide the native compact traffic-light controls and
        # inherit the active light/dark/high-contrast theme.
        header.set_show_start_title_buttons(True)
        header.set_show_end_title_buttons(True)
        self._header_title = _label("Settings", "section-heading")
        header.set_title_widget(self._header_title)
        self._back_button = Gtk.Button.new_from_icon_name("go-previous-symbolic")
        self._back_button.add_css_class("flat")
        self._set_accessible_label(self._back_button, "Back to Settings")
        self._back_button.set_tooltip_text("Back to Settings")
        self._back_button.connect("clicked", self._on_back_clicked)
        header.pack_start(self._back_button)
        self._advanced_button = Gtk.Button(label="Advanced")
        self._advanced_button.add_css_class("flat")
        self._set_accessible_label(self._advanced_button, "Open advanced Zeus settings")
        self._advanced_button.set_tooltip_text("Advanced Zeus settings and compatibility tools")
        self._advanced_button.connect("clicked", lambda _button: self.show_page("advanced"))
        header.pack_end(self._advanced_button)
        toolbar.add_top_bar(header)

        self._toast_overlay = Adw.ToastOverlay()
        self._stack = Gtk.Stack()
        self._stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self._stack.set_transition_duration(180)
        self._stack.set_hhomogeneous(False)
        self._stack.set_vhomogeneous(False)
        self._stack.add_named(self._wrap_page(self._build_content()), "home")
        for item in settings_model.DESTINATIONS:
            self._stack.add_named(self._wrap_page(self._build_detail_page(item)), item.key)
        self._stack.add_named(self._wrap_page(self._build_advanced_page()), "advanced")
        self._stack.add_named(self._wrap_page(self._build_about_page()), "about")

        self._split_view = Adw.OverlaySplitView()
        self._split_view.set_min_sidebar_width(210)
        self._split_view.set_max_sidebar_width(280)
        self._split_view.set_sidebar_width_fraction(0.30)
        self._split_view.set_pin_sidebar(True)
        # Begin in the compact state so a constrained or highly scaled display
        # never has to allocate both panes before its breakpoint is evaluated.
        self._split_view.set_collapsed(True)
        self._split_view.set_sidebar(self._wrap_page(self._build_sidebar()))
        self._split_view.set_content(self._stack)
        self._split_view.set_show_sidebar(True)
        self._split_view.connect("notify::collapsed", self._on_split_collapsed_changed)
        breakpoint = Adw.Breakpoint.new(
            Adw.BreakpointCondition.parse("min-width: 900px")
        )
        breakpoint.add_setter(self._split_view, "collapsed", False)
        self.add_breakpoint(breakpoint)

        self._toast_overlay.set_child(self._split_view)
        toolbar.set_content(self._toast_overlay)
        self.set_content(toolbar)

    @staticmethod
    def _wrap_page(content: Gtk.Widget) -> Gtk.ScrolledWindow:
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        clamp = Adw.Clamp()
        clamp.set_maximum_size(860)
        clamp.set_tightening_threshold(600)
        clamp.set_child(content)
        scroller.set_child(clamp)
        return scroller

    def _build_sidebar(self) -> Gtk.Widget:
        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        sidebar.add_css_class("settings-sidebar")
        sidebar.append(
            self._sidebar_button("home", "Overview", "preferences-system-symbolic")
        )
        sidebar.append(_label("EVERYDAY", "sidebar-eyebrow"))
        for item in settings_model.PANEL_DESTINATIONS:
            sidebar.append(self._sidebar_button(item.key, item.title, item.icon_name))
        sidebar.append(_label("ZEUS", "sidebar-eyebrow"))
        for item in settings_model.LOCAL_DESTINATIONS:
            sidebar.append(self._sidebar_button(item.key, item.title, item.icon_name))
        sidebar.append(
            self._sidebar_button(
                "advanced", "Advanced", "applications-engineering-symbolic"
            )
        )
        return sidebar

    def _sidebar_button(self, page: str, title: str, icon_name: str) -> Gtk.Button:
        button = Gtk.Button()
        button.add_css_class("flat")
        button.add_css_class("sidebar-button")
        button.set_hexpand(True)
        button.set_halign(Gtk.Align.FILL)
        self._set_accessible_label(button, title)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        icon = Gtk.Image.new_from_icon_name(icon_name)
        icon.set_pixel_size(18)
        row.append(icon)
        text = _label(title, "control-title")
        text.set_hexpand(True)
        text.set_halign(Gtk.Align.START)
        row.append(text)
        button.set_child(row)
        button.connect("clicked", lambda _button: self.show_page(page))
        self._sidebar_buttons[page] = button
        return button

    def show_page(self, page: str, *, add_history: bool = True):
        """Navigate to one allowlisted Zeus page and update window identity."""

        if self._closed:
            return
        previous = self._page
        selected = settings_model.normalize_page(page)
        if add_history and selected != previous:
            self._page_history.append(previous)
            self._page_history = self._page_history[-16:]
        self._page = selected
        self._stack.set_visible_child_name(selected)
        for key, button in self._sidebar_buttons.items():
            is_selected = key == selected
            if is_selected:
                button.add_css_class("selected")
            else:
                button.remove_css_class("selected")
            self._set_accessible_selected(button, is_selected)
        self._sync_sidebar_visibility()
        self._back_button.set_visible(selected != settings_model.DEFAULT_PAGE)
        item = settings_model.destination(selected)
        title = item.title if item is not None else {
            "home": "Settings",
            "advanced": "Advanced",
            "about": "About Zeus OS",
        }.get(selected, "Settings")
        back_page = self._page_history[-1] if self._page_history else settings_model.DEFAULT_PAGE
        back_item = settings_model.destination(back_page)
        back_title = back_item.title if back_item is not None else {
            "home": "Settings",
            "advanced": "Advanced",
            "about": "About Zeus OS",
        }.get(back_page, "Settings")
        self._set_accessible_label(self._back_button, f"Back to {back_title}")
        self._back_button.set_tooltip_text(f"Back to {back_title}")
        self._header_title.set_text(title)
        self.set_title(f"{title} — Zeus Settings" if selected != "home" else "Zeus Settings")
        if selected != previous:
            GLib.idle_add(self._focus_page_heading, selected)
        if self._wifi_controller is not None:
            if previous == "network" and selected != "network":
                self._wifi_controller.leave()
            elif selected == "network" and previous != "network":
                self._wifi_controller.enter()
        if self._bluetooth_controller is not None:
            if previous == "bluetooth" and selected != "bluetooth":
                self._bluetooth_controller.leave()
            elif selected == "bluetooth" and previous != "bluetooth":
                self._bluetooth_controller.enter()

    def _on_back_clicked(self, _button: Gtk.Button):
        target = self._page_history.pop() if self._page_history else settings_model.DEFAULT_PAGE
        self.show_page(target, add_history=False)

    def _focus_page_heading(self, page: str):
        if self._closed or self._page != page:
            return GLib.SOURCE_REMOVE
        heading = self._page_headings.get(page)
        if heading is not None:
            heading.grab_focus()
        return GLib.SOURCE_REMOVE

    def _on_split_collapsed_changed(self, _split_view, _parameter):
        self._sync_sidebar_visibility()

    def _sync_sidebar_visibility(self):
        collapsed = self._split_view.get_collapsed()
        self._split_view.set_show_sidebar(not collapsed or self._page == settings_model.DEFAULT_PAGE)
        self._advanced_button.set_visible(collapsed and self._page != "advanced")

    def _build_content(self) -> Gtk.Widget:
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        hero = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        hero.add_css_class("settings-hero")
        hero.append(_label("ZEUS OS", "eyebrow"))
        hero.append(self._page_heading("home", "Settings", "hero-title"))
        hero.append(
            _label(
                "Make it yours. A quiet home for the controls you use every day.",
                "hero-copy",
                wrap=True,
                max_width_chars=82,
            )
        )
        content.append(hero)

        controls = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        controls.add_css_class("content-section")
        controls.append(_label("Everyday controls", "section-heading"))
        self._brightness_label = _label(
            self._brightness_text(),
            "section-copy",
            wrap=True,
            max_width_chars=82,
        )
        controls.append(self._brightness_label)
        grid = Adw.WrapBox()
        grid.set_child_spacing(11)
        grid.set_line_spacing(11)
        grid.set_line_homogeneous(True)
        grid.set_natural_line_length(620)
        grid.add_css_class("control-grid")
        previous_card = None
        for item in settings_model.PANEL_DESTINATIONS:
            card = self._destination_button(item)
            card.set_size_request(270, -1)
            grid.insert_child_after(card, previous_card)
            previous_card = card
        controls.append(grid)
        content.append(controls)

        local = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        local.add_css_class("content-section")
        local.add_css_class("local-section")
        local.append(_label("Zeus tools", "section-heading"))
        local.append(
            _label(
                "Temp and OS updates, whenever you are ready.",
                "section-copy",
                wrap=True,
                max_width_chars=82,
            )
        )
        local_grid = Adw.WrapBox()
        local_grid.set_child_spacing(11)
        local_grid.set_line_spacing(11)
        local_grid.set_line_homogeneous(True)
        local_grid.set_natural_line_length(620)
        local_grid.add_css_class("control-grid")
        previous_card = None
        for item in settings_model.LOCAL_DESTINATIONS:
            card = self._destination_button(item)
            card.set_size_request(270, -1)
            local_grid.insert_child_after(card, previous_card)
            previous_card = card
        local.append(local_grid)
        content.append(local)

        # Keep the actionable cards together; hardware notes remain useful
        # context below them and never displace Temp or Updates from the first
        # view at the normal window size.
        content.append(self._build_hardware_card())

        footer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        footer.add_css_class("footer")
        footer.append(_label("Zeus OS", "footer-title"))
        footer.append(
            _label(
                f"Version {self._version} · Build {self._build_id}",
                "footer-copy",
                wrap=True,
                max_width_chars=82,
            )
        )
        content.append(footer)

        bottom_space = Gtk.Box()
        bottom_space.add_css_class("bottom-space")
        content.append(bottom_space)
        return content

    def _build_detail_page(self, item: settings_model.Destination) -> Gtk.Widget:
        if item.key == "network":
            return self._build_wifi_page(item)
        if item.key == "bluetooth":
            return self._build_bluetooth_page(item)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        page.add_css_class("detail-page")
        icon = Gtk.Image.new_from_icon_name(item.icon_name)
        icon.set_pixel_size(34)
        icon.set_halign(Gtk.Align.START)
        icon.add_css_class("detail-icon")
        page.append(icon)
        page.append(self._page_heading(item.key, item.title, "detail-title"))
        page.append(_label(item.summary, "detail-copy", wrap=True, max_width_chars=76))

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.add_css_class("detail-card")
        if item.command:
            card.append(_label(f"Open {item.title}", "detail-card-title"))
            card.append(
                _label(
                    f"{item.title} already uses a dedicated Zeus-owned window.",
                    "detail-card-copy",
                    wrap=True,
                    max_width_chars=72,
                )
            )
            action = Gtk.Button(label=f"Open {item.title}")
            action.set_halign(Gtk.Align.START)
            action.add_css_class("suggested-action")
            action.add_css_class("detail-actions")
            action.connect("clicked", lambda _button, selected=item: self._open_local(selected))
            card.append(action)
        else:
            card.append(_label("Compatibility-backed for now", "detail-card-title"))
            card.append(
                _label(
                    "Zeus Settings owns this destination, but these controls are not native "
                    "yet. The Fedora panel remains available as an explicitly labeled "
                    "compatibility tool while the Zeus page is built.",
                    "detail-card-copy",
                    wrap=True,
                    max_width_chars=72,
                )
            )
            compatibility = Gtk.Button(label="Open compatibility panel")
            compatibility.set_halign(Gtk.Align.START)
            compatibility.add_css_class("flat")
            compatibility.add_css_class("detail-actions")
            self._set_accessible_label(
                compatibility,
                f"Open the Fedora compatibility panel for {item.title}",
            )
            compatibility.connect(
                "clicked", lambda _button, selected=item: self._open_panel(selected)
            )
            card.append(compatibility)
        page.append(card)
        return page

    def _detail_page_intro(self, item: settings_model.Destination) -> Gtk.Box:
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        page.add_css_class("detail-page")
        icon = Gtk.Image.new_from_icon_name(item.icon_name)
        icon.set_pixel_size(34)
        icon.set_halign(Gtk.Align.START)
        icon.add_css_class("detail-icon")
        page.append(icon)
        page.append(self._page_heading(item.key, item.title, "detail-title"))
        page.append(_label(item.summary, "detail-copy", wrap=True, max_width_chars=76))
        return page

    def _build_wifi_page(self, item: settings_model.Destination) -> Gtk.Widget:
        page = self._detail_page_intro(item)
        toolbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        toolbar.add_css_class("page-toolbar")
        toolbar.set_hexpand(True)
        self._wifi_status = _label("Loading Wi-Fi…", "detail-copy", wrap=True)
        self._wifi_status.set_hexpand(True)
        self._set_accessible_role(self._wifi_status, "STATUS")
        toolbar.append(self._wifi_status)
        self._wifi_switch = Gtk.Switch()
        self._wifi_switch.set_valign(Gtk.Align.CENTER)
        self._set_accessible_label(self._wifi_switch, "Turn Wi-Fi on or off")
        self._wifi_switch.connect("notify::active", self._on_wifi_switch_changed)
        toolbar.append(self._wifi_switch)
        page.append(toolbar)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        actions.add_css_class("page-toolbar")
        self._wifi_refresh_button = Gtk.Button(label="Scan again")
        self._set_accessible_label(self._wifi_refresh_button, "Scan for Wi-Fi networks again")
        self._wifi_refresh_button.connect(
            "clicked", lambda _button: self._wifi_controller.request_scan()
        )
        actions.append(self._wifi_refresh_button)
        self._wifi_retry_button = Gtk.Button(label="Retry Wi-Fi")
        self._wifi_retry_button.connect(
            "clicked", lambda _button: self._wifi_controller.retry()
        )
        self._wifi_retry_button.set_visible(False)
        actions.append(self._wifi_retry_button)
        self._hotspot_button = Gtk.Button(label="Start hotspot")
        self._hotspot_button.connect("clicked", self._show_hotspot_dialog)
        actions.append(self._hotspot_button)
        page.append(actions)

        self._wifi_networks = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self._wifi_networks.add_css_class("page-toolbar")
        page.append(self._wifi_networks)
        return page

    def _on_wifi_switch_changed(self, switch: Gtk.Switch, _parameter):
        if not self._wifi_rendering and self._wifi_controller is not None:
            self._wifi_controller.set_enabled(switch.get_active())

    @staticmethod
    def _clear_box(box: Gtk.Box):
        child = box.get_first_child()
        while child is not None:
            following = child.get_next_sibling()
            box.remove(child)
            child = following

    def _render_wifi(self):
        if self._closed or not hasattr(self, "_wifi_networks"):
            return
        state = self._wifi_controller.snapshot() if self._wifi_controller else None
        if state is None:
            return
        self._wifi_rendering = True
        busy = state.pending is not None
        self._wifi_busy = busy
        ready = state.status == "ready" and state.available
        self._wifi_switch.set_sensitive(ready and not busy)
        self._wifi_switch.set_active(state.enabled)
        self._wifi_rendering = False
        self._hotspot_button.set_sensitive(
            ready and state.enabled and state.hotspot_supported and not busy
        )
        self._hotspot_button.set_label("Stop hotspot" if state.hotspot_active else "Start hotspot")
        self._set_accessible_label(
            self._hotspot_button,
            "Stop the Wi-Fi hotspot" if state.hotspot_active else "Start a Wi-Fi hotspot",
        )
        self._wifi_refresh_button.set_sensitive(
            ready and state.enabled and not state.scanning and not busy
        )
        self._wifi_retry_button.set_visible(state.status in {"error", "unavailable"})
        self._wifi_retry_button.set_sensitive(not busy)
        if state.pending == "hotspot-start":
            self._wifi_status.set_text("Starting hotspot…")
        elif state.pending == "hotspot-stop":
            self._wifi_status.set_text("Stopping hotspot…")
        elif state.pending:
            self._wifi_status.set_text("Finishing Wi-Fi change…")
        elif state.status == "loading":
            self._wifi_status.set_text("Loading Wi-Fi…")
        elif state.status == "error":
            self._wifi_status.set_text("Wi-Fi controls could not be loaded. Retry when ready.")
        elif not state.available:
            self._wifi_status.set_text(
                "No Wi-Fi adapter was detected. Ethernet and saved system networking "
                "remain available."
            )
        elif not state.enabled:
            self._wifi_status.set_text("Wi-Fi is off")
        elif state.scanning:
            self._wifi_status.set_text("Looking for networks…")
        else:
            self._wifi_status.set_text("Available networks")
        self._clear_box(self._wifi_networks)
        if not ready or not state.enabled:
            return
        if not state.networks and not state.scanning:
            self._wifi_networks.append(
                _label(
                    "No Wi-Fi networks are visible right now.",
                    "detail-card-copy",
                    wrap=True,
                )
            )
            return
        for network in state.networks:
            self._wifi_networks.append(self._wifi_network_row(network))

    def _wifi_network_row(self, network: settings_connectivity.WifiNetwork) -> Gtk.Widget:
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        row.add_css_class("setting-row")
        copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        copy.set_hexpand(True)
        copy.append(_row_title(network.name))
        security = {
            "open": "Open",
            "personal": "Secured",
            "sae": "WPA3 secured",
            "owe": "Enhanced open",
            "enterprise": "Enterprise security",
            "legacy": "Legacy security",
            "saved": "Saved",
        }.get(network.security, "Secured")
        if network.active:
            status = "Connected"
        elif not network.visible:
            status = "Saved · Not currently in range"
        else:
            status = f"{network.strength}% signal · {security}"
        copy.append(_label(status, "setting-row-copy", wrap=True))
        row.append(copy)
        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        actions.add_css_class("setting-row-actions")
        actions.set_sensitive(not getattr(self, "_wifi_busy", False))
        if network.active:
            button = Gtk.Button(label="Disconnect")
            self._set_accessible_label(button, f"Disconnect from {network.name}")
            button.connect("clicked", lambda _button: self._wifi_controller.disconnect())
            actions.append(button)
            # ZOS-124 plugs its authenticated QR disclosure into this active
            # row. Keep secret retrieval out of this connection controller so
            # there is one audited sharing path rather than a duplicate.
        elif network.security in {"enterprise", "legacy"} and not network.saved:
            button = Gtk.Button(label="Compatibility")
            self._set_accessible_label(
                button, f"Open compatibility settings for {network.name}"
            )
            button.connect(
                "clicked",
                lambda _button: self._open_panel(settings_model.destination("network")),
            )
            actions.append(button)
        else:
            button = Gtk.Button(label="Connect")
            self._set_accessible_label(button, f"Connect to {network.name}")
            button.add_css_class("suggested-action")
            button.connect("clicked", self._on_wifi_connect, network)
            actions.append(button)
        if network.saved:
            forget = Gtk.Button.new_from_icon_name("user-trash-symbolic")
            forget.add_css_class("flat")
            self._set_accessible_label(forget, f"Forget {network.name}")
            forget.connect("clicked", self._confirm_forget_wifi, network)
            actions.append(forget)
        row.append(actions)
        return row

    def _on_wifi_connect(self, _button: Gtk.Button, network: settings_connectivity.WifiNetwork):
        if network.saved or network.security in {"open", "owe"}:
            self._wifi_controller.connect_network(network.token)
            return
        dialog = Adw.AlertDialog.new(
            f"Join {network.name}?",
            "Enter the network password. Zeus passes it directly to NetworkManager "
            "and does not log or store its own copy.",
        )
        entry = Gtk.PasswordEntry()
        entry.set_show_peek_icon(True)
        entry.set_max_length(64)
        entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self._set_accessible_label(entry, f"Password for {network.name}")
        dialog.set_extra_child(entry)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("connect", "Connect")
        dialog.set_response_enabled("connect", False)
        dialog.set_response_appearance("connect", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("connect")
        dialog.set_close_response("cancel")
        entry.connect(
            "notify::text",
            lambda current, _parameter: dialog.set_response_enabled(
                "connect",
                settings_connectivity.validate_personal_password(current.get_text()),
            ),
        )
        dialog.connect("response", self._on_wifi_password_response, entry, network.token)
        dialog.present(self)

    def _on_wifi_password_response(self, _dialog, response: str, entry, token: str):
        if response != "connect" or self._closed:
            entry.set_text("")
            return
        password = entry.get_text()
        entry.set_text("")
        self._wifi_controller.connect_network(token, password)
        password = None

    def _confirm_forget_wifi(self, _button, network: settings_connectivity.WifiNetwork):
        dialog = Adw.AlertDialog.new(
            f"Forget {network.name}?",
            "Its saved NetworkManager connection and password will be removed from this computer.",
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("forget", "Forget")
        dialog.set_response_appearance("forget", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect(
            "response",
            lambda _dialog, response: self._wifi_controller.forget(network.token)
            if response == "forget" and not self._closed
            else None,
        )
        dialog.present(self)

    def _show_hotspot_dialog(self, _button):
        state = self._wifi_controller.snapshot()
        if state.hotspot_active:
            self._wifi_controller.stop_hotspot()
            return
        dialog = Adw.AlertDialog.new(
            "Start a Wi-Fi hotspot?",
            "Devices nearby will see this network. NetworkManager manages a temporary "
            "connection and removes it after the hotspot stops.",
        )
        fields = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        name = Gtk.Entry()
        name.set_text("Zeus Hotspot")
        name.set_max_length(32)
        self._set_accessible_label(name, "Hotspot name")
        password = Gtk.PasswordEntry()
        password.set_show_peek_icon(True)
        password.set_max_length(64)
        self._set_accessible_label(password, "Hotspot password")
        fields.append(_label("Network name", "detail-card-title"))
        fields.append(name)
        fields.append(_label("Password", "detail-card-title"))
        fields.append(password)
        fields.append(
            _label(
                "Use 8–63 characters, or exactly 64 hexadecimal characters.",
                "detail-card-copy",
                wrap=True,
            )
        )
        dialog.set_extra_child(fields)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("start", "Start hotspot")
        dialog.set_response_enabled("start", False)
        dialog.set_response_appearance("start", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("start")
        dialog.set_close_response("cancel")
        def update_start_response(*_args):
            dialog.set_response_enabled(
                "start",
                bool(name.get_text().strip())
                and settings_connectivity.validate_personal_password(password.get_text()),
            )

        name.connect("notify::text", update_start_response)
        password.connect("notify::text", update_start_response)
        dialog.connect("response", self._on_hotspot_response, name, password)
        dialog.present(self)

    def _on_hotspot_response(self, _dialog, response: str, name, password):
        if response != "start" or self._closed:
            password.set_text("")
            return
        secret = password.get_text()
        password.set_text("")
        self._wifi_controller.start_hotspot(name.get_text(), secret)
        secret = None

    def _build_bluetooth_page(self, item: settings_model.Destination) -> Gtk.Widget:
        page = self._detail_page_intro(item)
        toolbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        toolbar.add_css_class("page-toolbar")
        self._bluetooth_status = _label("Loading Bluetooth…", "detail-copy", wrap=True)
        self._bluetooth_status.set_hexpand(True)
        self._set_accessible_role(self._bluetooth_status, "STATUS")
        toolbar.append(self._bluetooth_status)
        self._bluetooth_switch = Gtk.Switch()
        self._bluetooth_switch.set_valign(Gtk.Align.CENTER)
        self._set_accessible_label(self._bluetooth_switch, "Turn Bluetooth on or off")
        self._bluetooth_switch.connect("notify::active", self._on_bluetooth_switch_changed)
        toolbar.append(self._bluetooth_switch)
        page.append(toolbar)
        self._bluetooth_retry_button = Gtk.Button(label="Retry Bluetooth")
        self._bluetooth_retry_button.set_halign(Gtk.Align.START)
        self._bluetooth_retry_button.add_css_class("page-toolbar")
        self._bluetooth_retry_button.connect(
            "clicked", lambda _button: self._bluetooth_controller.retry()
        )
        self._bluetooth_retry_button.set_visible(False)
        page.append(self._bluetooth_retry_button)
        self._bluetooth_devices = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self._bluetooth_devices.add_css_class("page-toolbar")
        page.append(self._bluetooth_devices)
        return page

    def _on_bluetooth_switch_changed(self, switch: Gtk.Switch, _parameter):
        if not self._bluetooth_rendering and self._bluetooth_controller is not None:
            self._bluetooth_controller.set_powered(switch.get_active())

    def _render_bluetooth(self):
        if self._closed or not hasattr(self, "_bluetooth_devices"):
            return
        state = self._bluetooth_controller.snapshot() if self._bluetooth_controller else None
        if state is None:
            return
        self._bluetooth_rendering = True
        busy = state.pending is not None
        self._bluetooth_busy = busy
        ready = state.status == "ready" and state.available
        self._bluetooth_switch.set_sensitive(ready and not busy)
        self._bluetooth_switch.set_active(state.powered)
        self._bluetooth_rendering = False
        self._bluetooth_retry_button.set_visible(state.status in {"error", "unavailable"})
        self._bluetooth_retry_button.set_sensitive(not busy)
        self._bluetooth_pairing_supported = state.pairing_supported
        if state.pending:
            self._bluetooth_status.set_text("Finishing Bluetooth change…")
        elif state.status == "loading":
            self._bluetooth_status.set_text("Loading Bluetooth…")
        elif state.status == "error":
            self._bluetooth_status.set_text(
                "Bluetooth controls could not be loaded. Retry when ready."
            )
        elif not state.available:
            self._bluetooth_status.set_text("No Bluetooth adapter was detected on this computer.")
        elif not state.powered:
            self._bluetooth_status.set_text("Bluetooth is off")
        elif state.scanning:
            self._bluetooth_status.set_text("Looking for nearby devices…")
        else:
            self._bluetooth_status.set_text("Nearby and saved devices")
        self._clear_box(self._bluetooth_devices)
        if not ready or not state.powered:
            return
        if not state.devices and not state.scanning:
            self._bluetooth_devices.append(
                _label(
                    "No Bluetooth devices are visible right now.",
                    "detail-card-copy",
                    wrap=True,
                )
            )
            return
        for device in state.devices:
            self._bluetooth_devices.append(self._bluetooth_device_row(device))

    def _bluetooth_device_row(self, device: settings_connectivity.BluetoothDevice) -> Gtk.Widget:
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        row.add_css_class("setting-row")
        copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        copy.set_hexpand(True)
        copy.append(_row_title(device.name))
        status = (
            "Connected"
            if device.connected
            else "Paired"
            if device.paired
            else "Ready to pair"
        )
        if device.trusted:
            status += " · Trusted"
        copy.append(_label(status, "setting-row-copy", wrap=True))
        row.append(copy)
        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        actions.add_css_class("setting-row-actions")
        actions.set_sensitive(not getattr(self, "_bluetooth_busy", False))
        if device.connected:
            action = Gtk.Button(label="Disconnect")
            self._set_accessible_label(action, f"Disconnect from {device.name}")
            action.connect(
                "clicked",
                lambda _button: self._bluetooth_controller.disconnect_device(device.token),
            )
        elif device.paired:
            action = Gtk.Button(label="Connect")
            self._set_accessible_label(action, f"Connect to {device.name}")
            action.add_css_class("suggested-action")
            action.connect(
                "clicked", lambda _button: self._bluetooth_controller.connect_device(device.token)
            )
        else:
            action = Gtk.Button(label="Pair")
            self._set_accessible_label(action, f"Pair with {device.name}")
            action.set_sensitive(getattr(self, "_bluetooth_pairing_supported", False))
            action.add_css_class("suggested-action")
            action.connect(
                "clicked", lambda _button: self._bluetooth_controller.pair(device.token)
            )
        actions.append(action)
        if device.paired:
            trust = Gtk.Button(label="Untrust" if device.trusted else "Trust")
            trust.add_css_class("flat")
            self._set_accessible_label(
                trust,
                f"{'Untrust' if device.trusted else 'Trust'} {device.name}",
            )
            trust.connect(
                "clicked",
                lambda _button: self._bluetooth_controller.set_trusted(
                    device.token, not device.trusted
                ),
            )
            actions.append(trust)
            remove = Gtk.Button.new_from_icon_name("user-trash-symbolic")
            remove.add_css_class("flat")
            self._set_accessible_label(remove, f"Remove {device.name}")
            remove.connect("clicked", self._confirm_remove_bluetooth, device)
            actions.append(remove)
        row.append(actions)
        return row

    def _show_bluetooth_pairing_prompt(self, prompt, respond):
        if self._closed:
            respond(None)
            return
        if prompt.kind == "display":
            dialog = Adw.AlertDialog.new(
                f"Pair with {prompt.name}",
                f"Enter {prompt.code} on the Bluetooth device, then finish pairing there.",
            )
            dialog.add_response("done", "Done")
            dialog.set_default_response("done")
            dialog.present(self)
            respond(True)
            return

        if prompt.kind in {"confirm", "authorize"}:
            body = (
                f"Confirm that {prompt.code} matches the code shown on the device."
                if prompt.kind == "confirm"
                else "Allow this saved Bluetooth device to connect to Zeus OS?"
            )
            dialog = Adw.AlertDialog.new(f"Pair with {prompt.name}?", body)
            dialog.add_response("cancel", "Cancel")
            dialog.add_response("allow", "Pair")
            dialog.set_response_appearance("allow", Adw.ResponseAppearance.SUGGESTED)
            dialog.set_default_response("allow")
            dialog.set_close_response("cancel")
            dialog.connect(
                "response",
                lambda _dialog, response: respond(True if response == "allow" else None),
            )
            dialog.present(self)
            return

        title = "PIN" if prompt.kind == "pin" else "passkey"
        dialog = Adw.AlertDialog.new(
            f"Enter the {title} for {prompt.name}",
            "The code is sent directly to BlueZ and is not saved by Zeus Settings.",
        )
        entry = Gtk.Entry()
        entry.set_max_length(16 if prompt.kind == "pin" else 6)
        if prompt.kind == "passkey":
            entry.set_input_purpose(Gtk.InputPurpose.DIGITS)
        self._set_accessible_label(entry, f"Bluetooth {title} for {prompt.name}")
        dialog.set_extra_child(entry)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("submit", "Continue")
        dialog.set_response_enabled("submit", False)
        dialog.set_response_appearance("submit", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("submit")
        dialog.set_close_response("cancel")

        def validate_code(current, _parameter):
            value = current.get_text()
            valid = bool(value) if prompt.kind == "pin" else value.isdigit() and len(value) <= 6
            dialog.set_response_enabled("submit", valid)

        entry.connect("notify::text", validate_code)

        def finish(_dialog, response):
            value = entry.get_text() if response == "submit" else None
            entry.set_text("")
            respond(value)

        dialog.connect("response", finish)
        dialog.present(self)

    def _confirm_remove_bluetooth(self, _button, device: settings_connectivity.BluetoothDevice):
        dialog = Adw.AlertDialog.new(
            f"Remove {device.name}?",
            "The BlueZ pairing will be removed from this computer.",
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("remove", "Remove")
        dialog.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect(
            "response",
            lambda _dialog, response: self._bluetooth_controller.remove(device.token)
            if response == "remove" and not self._closed
            else None,
        )
        dialog.present(self)

    def _build_advanced_page(self) -> Gtk.Widget:
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        page.add_css_class("detail-page")
        page.append(_label("ADVANCED", "eyebrow"))
        page.append(self._page_heading("advanced", "Advanced", "detail-title"))
        page.append(
            _label(
                "Developer controls, system identity, and an explicit recovery path.",
                "detail-copy",
                wrap=True,
                max_width_chars=76,
            )
        )
        page.append(self._build_developer_card())

        compatibility = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        compatibility.add_css_class("detail-card")
        compatibility.append(_label("Fedora compatibility", "detail-card-title"))
        compatibility.append(
            _label(
                "Use the stock control center only for an uncommon control that Zeus "
                "Settings does not cover yet. It remains installed for recovery and "
                "does not replace Zeus defaults.",
                "detail-card-copy",
                wrap=True,
                max_width_chars=72,
            )
        )
        open_compatibility = Gtk.Button(label="Open Fedora compatibility settings")
        open_compatibility.set_halign(Gtk.Align.START)
        open_compatibility.add_css_class("flat")
        open_compatibility.add_css_class("detail-actions")
        open_compatibility.connect("clicked", self._open_native_settings)
        compatibility.append(open_compatibility)
        page.append(compatibility)

        about = Gtk.Button(label="About Zeus OS")
        about.set_halign(Gtk.Align.START)
        about.add_css_class("flat")
        about.add_css_class("detail-actions")
        about.connect("clicked", lambda _button: self.show_page("about"))
        page.append(about)
        return page

