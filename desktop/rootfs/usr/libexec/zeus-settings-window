#!/usr/bin/env python3
"""Native Zeus Settings application for the controls people use every day.

Zeus keeps hardware policy in Fedora's supported stack while owning the visible
navigation and page identity.  Normal entry points stay inside this window;
the stock control center remains an explicit compatibility fallback while
individual controls migrate to Zeus-native pages.
"""

from __future__ import annotations

import sys
from typing import Any

import gi

gi.require_version("Adw", "1")
gi.require_version("Gtk", "4.0")
from gi.repository import Adw, Gio, GLib, Gtk, Pango


MODEL_PATH = "/usr/lib/zeus"
if MODEL_PATH not in sys.path:
    sys.path.insert(0, MODEL_PATH)

import settings_model
import settings_connectivity


APPLICATION_ID = "org.zeus.Settings"
NATIVE_SETTINGS_DESKTOP_ID = "org.gnome.Settings.desktop"
GNOME_CONTROL_CENTER_COMMAND = "/usr/bin/gnome-control-center"
DEVELOPER_COMMAND = "/usr/libexec/zeus-developer"
DEVELOPER_STATUS_OUTPUT_LIMIT = 64 * 1024


