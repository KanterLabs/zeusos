def _label(
    text: str,
    css_class: str,
    *,
    wrap: bool = False,
    max_width_chars: int | None = None,
) -> Gtk.Label:
    label = Gtk.Label(label=text)
    label.set_xalign(0)
    label.add_css_class(css_class)
    if wrap:
        label.set_wrap(True)
        label.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
        label.set_hexpand(True)
        if max_width_chars is not None:
            label.set_max_width_chars(max_width_chars)
    return label


def _safe_hardware_snapshot() -> settings_model.HardwareState:
    """Return an honest unknown state if sysfs cannot be read at startup."""

    try:
        return settings_model.discover_hardware()
    except (OSError, RuntimeError, TypeError, ValueError):
        return settings_model.HardwareState(None, None, None, None)


class SettingsWindow(Adw.ApplicationWindow):
    """A compact native directory for system and Zeus settings."""

    def __init__(self, application: Adw.Application):
        super().__init__(application=application, title="Settings")
        self.set_default_size(760, 720)
        self.set_size_request(520, 500)
        self.add_css_class("zeus-window")
        self._closed = False
        self._hardware = _safe_hardware_snapshot()
        self._version, self._build_id = settings_model.read_build_identity()
        self._developer_status = settings_model.default_developer_status()
        self._developer_status_in_flight = False
        self._developer_action_in_flight = False
        self._developer_action: str | None = None
        self._developer_process = None
        self._developer_cancellable = None
        self._developer_notice = ""
        self._developer_notice_kind = "info"
        self._developer_preserve_notice = False

        self._install_css()
        self._build_window()
        # The helper is queried once when the window opens.  Later reads happen
        # after an explicit action or when the window becomes active; there is
        # no timer or background polling while Settings is idle.
        self._request_developer_status()
        # Hardware can change while the window is open (for example after a
        # dock or adapter is connected).  Refresh only on an activation signal;
        # there is no timer or background watcher while Settings is idle.
        self.connect("notify::is-active", self._on_active_changed)

    def _install_css(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode("utf-8"))
        display = self.get_display()
        if display is not None:
            Gtk.StyleContext.add_provider_for_display(
                display,
                provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )

    @staticmethod
    def _set_accessible_label(widget: Gtk.Widget, label: str):
        accessible_property = getattr(Gtk, "AccessibleProperty", None)
        update_property = getattr(widget, "update_property", None)
        if accessible_property is not None and update_property is not None:
            try:
                update_property([accessible_property.LABEL], [label])
                return
            except (AttributeError, TypeError, ValueError):
                pass
        try:
            widget.set_tooltip_text(label)
        except (AttributeError, RuntimeError):
            pass

    def _build_window(self):
        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        # Let libadwaita provide the native compact traffic-light controls and
        # inherit the active light/dark/high-contrast theme.
        header.set_show_start_title_buttons(True)
        header.set_show_end_title_buttons(True)
        header.set_title_widget(_label("Settings", "section-heading"))
        all_settings = Gtk.Button(label="All Settings")
        all_settings.add_css_class("flat")
        self._set_accessible_label(all_settings, "Open all settings")
        all_settings.set_tooltip_text("Open the complete system settings")
        all_settings.connect("clicked", self._open_native_settings)
        header.pack_end(all_settings)
        toolbar.add_top_bar(header)

        self._toast_overlay = Adw.ToastOverlay()
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        clamp = Adw.Clamp()
        clamp.set_maximum_size(860)
        clamp.set_tightening_threshold(600)
        clamp.set_child(self._build_content())
        scroller.set_child(clamp)
        self._toast_overlay.set_child(scroller)
        toolbar.set_content(self._toast_overlay)
        self.set_content(toolbar)

    def _build_content(self) -> Gtk.Widget:
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        hero = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        hero.add_css_class("settings-hero")
        hero.append(_label("ZEUS OS", "eyebrow"))
        hero.append(_label("Make it yours", "hero-title"))
        hero.append(
            _label(
                "A quiet home for the controls you use every day.",
                "hero-copy",
                wrap=True,
                max_width_chars=82,
            )
        )
        content.append(hero)

        controls = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        controls.add_css_class("content-section")
        controls.append(_label("Everyday controls", "section-heading"))
        self._brightness_label = _label(
            self._brightness_text(),
            "section-copy",
            wrap=True,
            max_width_chars=82,
        )
        controls.append(self._brightness_label)
        grid = Gtk.Grid(column_spacing=11, row_spacing=11)
        grid.set_column_homogeneous(True)
        grid.add_css_class("control-grid")
        for index, item in enumerate(settings_model.PANEL_DESTINATIONS):
            grid.attach(
                self._destination_button(item),
                index % 2,
                index // 2,
                1,
                1,
            )
        controls.append(grid)
        content.append(controls)

        local = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        local.add_css_class("content-section")
        local.add_css_class("local-section")
        local.append(_label("Zeus tools", "section-heading"))
        local.append(
            _label(
                "Temp and OS updates, whenever you are ready.",
                "section-copy",
                wrap=True,
                max_width_chars=82,
            )
        )
        local_grid = Gtk.Grid(column_spacing=11, row_spacing=11)
        local_grid.set_column_homogeneous(True)
        local_grid.add_css_class("control-grid")
        for index, item in enumerate(settings_model.LOCAL_DESTINATIONS):
            local_grid.attach(self._destination_button(item), index, 0, 1, 1)
        local.append(local_grid)
        content.append(local)

        advanced = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        advanced.add_css_class("content-section")
        advanced.add_css_class("advanced-section")
        advanced.append(_label("Advanced", "section-heading"))
        advanced.append(
            _label(
                "Optional repository-backed controls for verified desktop iterations.",
                "section-copy",
                wrap=True,
                max_width_chars=82,
            )
        )
        advanced.append(self._build_developer_card())
        content.append(advanced)

        # Keep the actionable cards together; hardware notes remain useful
        # context below them and never displace Temp or Updates from the first
        # view at the normal window size.
        content.append(self._build_hardware_card())

        footer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        footer.add_css_class("footer")
        footer.append(_label("Zeus OS", "footer-title"))
        footer.append(
            _label(
                f"Version {self._version} · Build {self._build_id}",
                "footer-copy",
                wrap=True,
                max_width_chars=82,
            )
        )
        content.append(footer)

        bottom_space = Gtk.Box()
        bottom_space.add_css_class("bottom-space")
        content.append(bottom_space)
        return content

    def _build_developer_card(self) -> Gtk.Widget:
        """Build the compact Advanced → Developer Mode card."""

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.add_css_class("developer-card")
        self._developer_card = card

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        icon = Gtk.Image.new_from_icon_name("applications-development-symbolic")
        icon.set_pixel_size(22)
        icon.set_valign(Gtk.Align.START)
        icon.add_css_class("developer-icon")
        top.append(icon)

        copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        copy.set_hexpand(True)
        copy.append(_label("Developer Mode", "developer-title"))
        self._developer_state_label = _label(
            settings_model.developer_state_title(self._developer_status.state),
            "developer-state",
            wrap=True,
        )
        copy.append(self._developer_state_label)
        self._developer_copy_label = _label(
            settings_model.developer_state_description(self._developer_status),
            "developer-copy",
            wrap=True,
            max_width_chars=86,
        )
        copy.append(self._developer_copy_label)
        top.append(copy)
        self._developer_spinner = Gtk.Spinner()
        self._developer_spinner.set_size_request(22, 22)
        self._developer_spinner.set_visible(False)
        top.append(self._developer_spinner)
        card.append(top)

        self._developer_meta_label = _label(
            settings_model.developer_status_summary(self._developer_status),
            "developer-meta",
            wrap=True,
            max_width_chars=100,
        )
        card.append(self._developer_meta_label)
        self._developer_activation_label = _label(
            self._developer_activation_text(self._developer_status),
            "developer-meta",
            wrap=True,
            max_width_chars=100,
        )
        card.append(self._developer_activation_label)
        self._developer_receipt_label = _label(
            self._developer_receipt_text(self._developer_status),
            "developer-meta",
            wrap=True,
            max_width_chars=100,
        )
        card.append(self._developer_receipt_label)
        self._developer_auth_label = _label(
            "Administrator authentication may be requested. Cancel leaves Developer Mode unchanged.",
            "developer-auth",
            wrap=True,
            max_width_chars=100,
        )
        card.append(self._developer_auth_label)
        self._developer_notice_label = _label("", "developer-copy", wrap=True, max_width_chars=100)
        card.append(self._developer_notice_label)

        self._developer_progress_label = _label("", "developer-progress", wrap=True, max_width_chars=100)
        self._developer_progress_label.set_visible(False)
        card.append(self._developer_progress_label)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        actions.add_css_class("developer-actions")
        self._developer_enable_button = Gtk.Button(label="Enable Developer Mode")
        self._developer_enable_button.set_tooltip_text("Enable Developer Mode after administrator authentication")
        self._set_accessible_label(self._developer_enable_button, "Enable Developer Mode")
        self._developer_enable_button.connect("clicked", self._on_developer_action_clicked, "enable")
        actions.append(self._developer_enable_button)

        self._developer_apply_button = Gtk.Button(label="Apply prepared change")
        self._developer_apply_button.add_css_class("suggested-action")
        self._developer_apply_button.set_tooltip_text(
            "Apply the verified repository artifact prepared from the current commit"
        )
        self._set_accessible_label(self._developer_apply_button, "Apply prepared repository change")
        self._developer_apply_button.connect("clicked", self._on_developer_action_clicked, "apply")
        actions.append(self._developer_apply_button)

        self._developer_undo_button = Gtk.Button(label="Undo last apply")
        self._developer_undo_button.set_tooltip_text("Return to the preceding verified Developer Mode artifact")
        self._set_accessible_label(self._developer_undo_button, "Undo last Developer Mode apply")
        self._developer_undo_button.connect("clicked", self._on_developer_action_clicked, "undo")
        actions.append(self._developer_undo_button)

        self._developer_disable_button = Gtk.Button(label="Turn off Developer Mode")
        self._developer_disable_button.set_tooltip_text("Turn off Developer Mode and leave the base image unchanged")
        self._set_accessible_label(self._developer_disable_button, "Turn off Developer Mode")
        self._developer_disable_button.connect("clicked", self._on_developer_action_clicked, "disable")
        actions.append(self._developer_disable_button)

        self._developer_cancel_button = Gtk.Button(label="Cancel")
        self._developer_cancel_button.set_tooltip_text("Cancel the current request")
        self._set_accessible_label(self._developer_cancel_button, "Cancel Developer Mode request")
        self._developer_cancel_button.connect("clicked", self._on_developer_cancel_clicked)
        self._developer_cancel_button.set_visible(False)
        actions.append(self._developer_cancel_button)
        card.append(actions)

        self._render_developer_status()
        return card

    @staticmethod
    def _developer_activation_text(status: settings_model.DeveloperStatus) -> str:
        action = {
            "none": "Activation: no restart or logout required.",
            "restart": "Activation: restart the affected app after applying.",
            "logout": "Activation: log out and back in after applying.",
            "reboot": "Activation: restart the system after applying.",
        }.get(status.required_action, "Activation: follow the helper's restart guidance.")
        if status.applied_at:
            return f"{action} Applied: {status.applied_at}"
        return action

    @staticmethod
    def _developer_receipt_text(status: settings_model.DeveloperStatus) -> str:
        receipt = status.focused_test_receipt or "No focused-test receipt recorded."
        if status.applied_at:
            return f"Focused tests: {receipt} · Applied: {status.applied_at}"
        return f"Focused tests: {receipt}"

    def _render_developer_status(self):
        """Render status and action availability without starting any work."""

        status = getattr(self, "_developer_status", settings_model.default_developer_status())
        state = status.state
        card = getattr(self, "_developer_card", None)
        if card is not None:
            for css_class in settings_model.DEVELOPER_STATUS_STATES:
                try:
                    card.remove_css_class(css_class)
                except (AttributeError, RuntimeError, TypeError):
                    pass
            try:
                card.add_css_class(state)
            except (AttributeError, RuntimeError, TypeError):
                pass

        state_label = getattr(self, "_developer_state_label", None)
        if state_label is not None:
            state_label.set_text(settings_model.developer_state_title(state))
        copy_label = getattr(self, "_developer_copy_label", None)
        if copy_label is not None:
            copy_label.set_text(settings_model.developer_state_description(status))
        meta_label = getattr(self, "_developer_meta_label", None)
        if meta_label is not None:
            meta_label.set_text(settings_model.developer_status_summary(status))
        activation_label = getattr(self, "_developer_activation_label", None)
        if activation_label is not None:
            activation_label.set_text(self._developer_activation_text(status))
        receipt_label = getattr(self, "_developer_receipt_label", None)
        if receipt_label is not None:
            receipt_label.set_text(self._developer_receipt_text(status))

        notice = getattr(self, "_developer_notice", "")
        notice_label = getattr(self, "_developer_notice_label", None)
        if notice_label is not None:
            notice_label.set_text(notice)
            notice_label.set_visible(bool(notice))
            try:
                notice_label.remove_css_class("error")
                if getattr(self, "_developer_notice_kind", "info") == "error":
                    notice_label.add_css_class("error")
            except (AttributeError, RuntimeError, TypeError):
                pass

        busy = bool(
            getattr(self, "_developer_status_in_flight", False)
            or getattr(self, "_developer_action_in_flight", False)
        )
        progress_label = getattr(self, "_developer_progress_label", None)
        if progress_label is not None:
            if busy:
                action = getattr(self, "_developer_action", None)
                progress_label.set_text(
                    "Reading Developer Mode status…"
                    if action is None
                    else "Administrator authentication may appear; verifying the request…"
                )
            progress_label.set_visible(busy)
        spinner = getattr(self, "_developer_spinner", None)
        if spinner is not None:
            spinner.set_visible(busy)
            try:
                if busy:
                    spinner.start()
                else:
                    spinner.stop()
            except (AttributeError, RuntimeError, TypeError):
                pass

        availability = {
            "enable": state in {"off", "error"},
            "apply": state in {"enabled", "active", "incompatible", "error"},
            "undo": state == "active",
            "disable": state in {"enabled", "active", "incompatible", "error"},
        }
        for action, available in availability.items():
            button = getattr(self, f"_developer_{action}_button", None)
            if button is not None:
                button.set_sensitive(bool(available and not busy))
        cancel_button = getattr(self, "_developer_cancel_button", None)
        if cancel_button is not None:
            cancel_button.set_visible(busy)
            cancel_button.set_sensitive(busy)

    def _request_developer_status(self, *, preserve_notice: bool = False):
        if self._closed or getattr(self, "_developer_status_in_flight", False):
            return
        if getattr(self, "_developer_action_in_flight", False):
            return
        self._developer_status_in_flight = True
        self._developer_action = None
        self._developer_preserve_notice = bool(preserve_notice)
        if not preserve_notice:
            self._developer_notice = ""
            self._developer_notice_kind = "info"
        self._render_developer_status()
        self._start_developer_process("status", True, self._after_developer_status)

    @staticmethod
    def _developer_output_text(value: Any, fallback: str = "", *, limit: int = 512) -> str:
        if isinstance(value, str):
            text = value.strip()
        else:
            text = "" if value is None else str(value).strip()
        return text[:limit] if text else fallback

    def _start_developer_process(self, action: str, json_status: bool, callback):
        """Start the fixed helper argv and report completion through Gio."""

        if action not in settings_model.DEVELOPER_ACTIONS or (json_status and action != "status"):
            callback(False, "", "", "Invalid Developer Mode action.", False)
            return
        arguments = (DEVELOPER_COMMAND, action) + (("--json",) if json_status else ())

        subprocess_flags = getattr(Gio, "SubprocessFlags", None)
        if subprocess_flags is None:
            flags = 0
        else:
            flags = getattr(subprocess_flags, "STDOUT_PIPE", 0) | getattr(
                subprocess_flags, "STDERR_PIPE", 0
            )
        try:
            process = Gio.Subprocess.new(list(arguments), flags)
        except (AttributeError, GLib.Error, OSError, TypeError, ValueError) as error:
            callback(False, "", "", f"Could not start Developer Mode: {error}", False)
            return

        self._developer_process = process
        try:
            self._developer_cancellable = Gio.Cancellable()
        except (AttributeError, GLib.Error, TypeError):
            self._developer_cancellable = None

        context = (action, callback)
        communicate = getattr(process, "communicate_utf8_async", None)
        if communicate is not None:
            try:
                communicate(None, self._developer_cancellable, self._on_developer_process_finished, context)
                return
            except (AttributeError, GLib.Error, OSError, TypeError, ValueError) as error:
                self._finish_developer_process(action, callback, False, "", "", str(error), False)
                return

        wait_async = getattr(process, "wait_check_async", None)
        if wait_async is None:
            self._finish_developer_process(
                action,
                callback,
                False,
                "",
                "",
                "Developer Mode helper cannot report completion.",
                False,
            )
            return
        try:
            wait_async(
                GLib.PRIORITY_DEFAULT,
                self._developer_cancellable,
                self._on_developer_wait_finished,
                context,
            )
        except (AttributeError, GLib.Error, OSError, TypeError, ValueError) as error:
            self._finish_developer_process(action, callback, False, "", "", str(error), False)

    def _on_developer_process_finished(self, process, result, context):
        action, callback = context
        try:
            outcome = process.communicate_utf8_finish(result)
            communicated = bool(outcome[0]) if isinstance(outcome, tuple) else bool(outcome)
            stdout = outcome[1] if isinstance(outcome, tuple) and len(outcome) > 1 else ""
            stderr = outcome[2] if isinstance(outcome, tuple) and len(outcome) > 2 else ""
            error = ""
            # ``communicate_utf8_finish`` reports whether I/O completed; a
            # helper that returned a structured failure can still make that
            # value true.  Prefer Gio's child-status result when available so
            # the action cannot be shown as successful after auth denial or a
            # failed transactional operation.
            get_successful = getattr(process, "get_successful", None)
            if callable(get_successful):
                try:
                    succeeded = bool(get_successful())
                except (AttributeError, GLib.Error, OSError, TypeError, ValueError):
                    succeeded = communicated
            else:
                succeeded = communicated
        except (AttributeError, GLib.Error, OSError, TypeError, ValueError) as caught:
            succeeded, stdout, stderr, error = False, "", "", str(caught)
        self._finish_developer_process(action, callback, succeeded, stdout, stderr, error, self._developer_was_cancelled())

    def _on_developer_wait_finished(self, process, result, context):
        action, callback = context
        try:
            succeeded = bool(process.wait_check_finish(result))
            error = ""
        except (AttributeError, GLib.Error, OSError, TypeError, ValueError) as caught:
            succeeded, error = False, str(caught)
        self._finish_developer_process(action, callback, succeeded, "", "", error, self._developer_was_cancelled())

    def _developer_was_cancelled(self) -> bool:
        cancellable = getattr(self, "_developer_cancellable", None)
        is_cancelled = getattr(cancellable, "is_cancelled", None)
        if callable(is_cancelled):
            try:
                return bool(is_cancelled())
            except (AttributeError, GLib.Error, TypeError):
                return False
        return False

    def _finish_developer_process(
        self,
        action: str,
        callback,
        succeeded: bool,
        stdout: str,
        stderr: str,
        error: str,
        canceled: bool,
    ):
        self._developer_process = None
        self._developer_cancellable = None
        stdout_limit = DEVELOPER_STATUS_OUTPUT_LIMIT if action == "status" else 512
        callback(
            bool(succeeded),
            self._developer_output_text(stdout, limit=stdout_limit),
            self._developer_output_text(stderr),
            self._developer_output_text(error),
            bool(canceled),
        )

    def _after_developer_status(
        self,
        succeeded: bool,
        stdout: str,
        stderr: str,
        error: str,
        canceled: bool,
    ):
        if self._closed:
            return
        self._developer_status_in_flight = False
        self._developer_action = None
        if canceled:
            self._developer_notice = "Status request canceled."
            self._developer_notice_kind = "info"
        else:
            parsed = settings_model.developer_status_from_json(stdout)
            if stdout.strip() and parsed.state != "error":
                self._developer_status = parsed
                if not getattr(self, "_developer_preserve_notice", False):
                    self._developer_notice = ""
                    self._developer_notice_kind = "info"
            elif stdout.strip() and parsed.error and not stderr:
                self._developer_status = parsed
                self._developer_notice = parsed.error
                self._developer_notice_kind = "error"
            else:
                detail = error or stderr or "The Developer Mode status is unavailable."
                self._developer_status = settings_model.DeveloperStatus(state="error", error=detail)
                self._developer_notice = detail
                self._developer_notice_kind = "error"
        self._developer_preserve_notice = False
        self._render_developer_status()

    def _after_developer_action(
        self,
        succeeded: bool,
        stdout: str,
        stderr: str,
        error: str,
        canceled: bool,
    ):
        if self._closed:
            return
        action = self._developer_action or "request"
        self._developer_action_in_flight = False
        self._developer_action = None
        if canceled:
            self._developer_notice = "Request canceled. Developer Mode was not changed."
            self._developer_notice_kind = "info"
        elif not succeeded:
            parsed = settings_model.developer_status_from_json(stdout)
            self._developer_notice = (
                error
                or stderr
                or parsed.message
                or parsed.error
                or f"Developer Mode {action} failed."
            )
            self._developer_notice_kind = "error"
        else:
            self._developer_notice = f"Developer Mode {action} completed; refreshing status."
            self._developer_notice_kind = "info"
        self._render_developer_status()
        # Status is refreshed only after an explicit action, so an accepted
        # apply/undo/disable becomes visible without idle polling.
        self._request_developer_status(preserve_notice=True)

    def _on_developer_action_clicked(self, _button: Gtk.Button, action: str):
        if self._closed or action not in settings_model.DEVELOPER_ACTIONS or action == "status":
            return
        if getattr(self, "_developer_action_in_flight", False):
            return
        self._developer_action_in_flight = True
        self._developer_action = action
        self._developer_notice = (
            "Administrator authentication is required to enable Developer Mode."
            if action == "enable"
            else f"Administrator authentication may be requested before {action}."
        )
        self._developer_notice_kind = "info"
        self._render_developer_status()
        self._start_developer_process(action, False, self._after_developer_action)

    def _on_developer_cancel_clicked(self, _button: Gtk.Button):
        action_in_flight = bool(getattr(self, "_developer_action_in_flight", False))
        status_in_flight = bool(getattr(self, "_developer_status_in_flight", False))
        if not action_in_flight and not status_in_flight:
            return
        cancellable = getattr(self, "_developer_cancellable", None)
        cancel = getattr(cancellable, "cancel", None)
        if callable(cancel):
            try:
                cancel()
            except (AttributeError, GLib.Error, RuntimeError, TypeError):
                pass
        else:
            process = getattr(self, "_developer_process", None)
            force_exit = getattr(process, "force_exit", None)
            if callable(force_exit):
                try:
                    force_exit()
                except (AttributeError, GLib.Error, OSError, RuntimeError, TypeError):
                    pass
        self._developer_notice = (
            "Canceling Developer Mode request…"
            if action_in_flight
            else "Canceling Developer Mode status request…"
        )
        self._developer_notice_kind = "info"
        self._render_developer_status()

    def _build_hardware_card(self) -> Gtk.Widget:
        section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        section.add_css_class("content-section")
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.add_css_class("hardware-card")

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        icon = Gtk.Image.new_from_icon_name("computer-symbolic")
        icon.set_pixel_size(22)
        icon.add_css_class("hardware-icon")
        icon.set_valign(Gtk.Align.START)
        top.append(icon)
        copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        copy.set_hexpand(True)
        copy.append(_label("This device", "hardware-title"))
        self._hardware_summary_label = _label(
            settings_model.hardware_summary(self._hardware),
            "hardware-copy",
            wrap=True,
            max_width_chars=92,
        )
        copy.append(self._hardware_summary_label)
        top.append(copy)
        card.append(top)

        section.append(card)
        return section

    def _on_active_changed(self, _window: Gtk.Window, _param_spec: Any):
        """Refresh the display-only hardware note when the window is focused."""

        if self._closed:
            return
        is_active = getattr(self, "is_active", None)
        if callable(is_active):
            try:
                if not is_active():
                    return
            except (AttributeError, RuntimeError, TypeError):
                pass
        state = _safe_hardware_snapshot()
        if state != self._hardware:
            self._hardware = state
            summary_label = getattr(self, "_hardware_summary_label", None)
            if summary_label is not None:
                summary_label.set_text(settings_model.hardware_summary(state))
            brightness_label = getattr(self, "_brightness_label", None)
            if brightness_label is not None:
                brightness_label.set_text(self._brightness_text())
        # Re-read the bounded public receipt when the Settings window becomes
        # active again.  This catches a Developer Mode change made by the CLI
        # or a second Settings instance without introducing an idle poll.
        if hasattr(self, "_developer_status"):
            self._request_developer_status(preserve_notice=True)

    def _brightness_text(self) -> str:
        if self._hardware.backlight is True:
            return "Brightness is available in the top-right system menu."
        if self._hardware.backlight is False:
            return "Brightness: no laptop backlight detected on this device."
        return "Check the top-right menu for brightness on supported displays."

    def _destination_button(self, item: settings_model.Destination) -> Gtk.Button:
        button = Gtk.Button()
        button.add_css_class("card")
        button.add_css_class("control-card")
        button.set_hexpand(True)
        button.set_halign(Gtk.Align.FILL)
        self._set_accessible_label(button, item.title)
        button.set_tooltip_text(f"Open {item.title}")

        card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        card.set_halign(Gtk.Align.FILL)
        icon = Gtk.Image.new_from_icon_name(item.icon_name)
        icon.set_pixel_size(23)
        icon.set_valign(Gtk.Align.CENTER)
        icon.add_css_class("control-icon")
        card.append(icon)
        copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        copy.set_hexpand(True)
        copy.set_valign(Gtk.Align.CENTER)
        copy.append(_label(item.title, "control-title"))
        copy.append(_label(item.summary, "control-summary", wrap=True, max_width_chars=38))
        card.append(copy)
        chevron = Gtk.Image.new_from_icon_name("go-next-symbolic")
        chevron.set_pixel_size(16)
        chevron.set_valign(Gtk.Align.CENTER)
        chevron.add_css_class("control-chevron")
        card.append(chevron)
        button.set_child(card)
        button.connect("clicked", self._on_destination_clicked, item)
        return button

    def _on_destination_clicked(self, _button: Gtk.Button, item: settings_model.Destination):
        if item.panel_ids:
            self._open_panel(item)
            return
        self._open_local(item)

    def _launch_context(self):
        try:
            display = self.get_display()
            if display is not None:
                return display.get_app_launch_context()
        except (AttributeError, RuntimeError, TypeError):
            pass
        return None

    def _launch_desktop_app(self, desktop_id: str, label: str) -> bool:
        """Launch one fixed desktop ID without a shell or query expansion."""

        try:
            desktop = Gio.DesktopAppInfo.new(desktop_id)
        except (GLib.Error, OSError, TypeError, ValueError):
            desktop = None
        if desktop is None:
            return False
        try:
            result = desktop.launch([], self._launch_context())
            if result is False:
                return False
        except (GLib.Error, OSError, TypeError, ValueError) as error:
            self._show_toast(f"Could not open {label}: {error}")
            return False
        return True

    def _spawn_fixed(self, arguments: tuple[str, ...], label: str):
        """Start one fixed argv asynchronously; never invoke a shell."""

        try:
            return Gio.Subprocess.new(list(arguments), Gio.SubprocessFlags.NONE)
        except (GLib.Error, OSError, TypeError, ValueError) as error:
            self._show_toast(f"Could not open {label}: {error}")
            return None

    def _open_panel(self, item: settings_model.Destination):
        self._try_panel_desktop(item, 0, settings_model.panel_attempt_order(item, self._hardware))

    def _try_panel_desktop(
        self,
        item: settings_model.Destination,
        index: int,
        order: tuple[int, ...] | None = None,
    ):
        if self._closed:
            return
        if order is None:
            order = settings_model.panel_attempt_order(item, getattr(self, "_hardware", None))
        if index >= len(order):
            self._try_panel_command(item, 0, order)
            return
        panel_index = order[index]
        desktop_ids = item.panel_desktop_ids
        if panel_index < len(desktop_ids):
            if self._launch_desktop_app(desktop_ids[panel_index], item.title):
                return
            self._try_panel_desktop(item, index + 1, order)
            return
        self._try_panel_desktop(item, index + 1, order)

    def _try_panel_command(
        self,
        item: settings_model.Destination,
        index: int,
        order: tuple[int, ...] | None = None,
    ):
        if self._closed:
            return
        if order is None:
            order = settings_model.panel_attempt_order(item, getattr(self, "_hardware", None))
        if index >= len(order):
            self._open_native_settings()
            return
        panel_index = order[index]
        try:
            arguments = settings_model.panel_argv(item, panel_index)
        except ValueError:
            self._try_panel_command(item, index + 1, order)
            return
        process = self._spawn_fixed(arguments, item.title)
        if process is None:
            self._try_panel_command(item, index + 1, order)
            return
        wait_async = getattr(process, "wait_check_async", None)
        if wait_async is None:
            return
        try:
            wait_async(
                GLib.PRIORITY_DEFAULT,
                None,
                self._on_panel_command_finished,
                (item, index, order),
            )
        except (GLib.Error, OSError, TypeError, ValueError):
            # The process has been handed off already.  Do not synchronously
            # wait in the GTK loop; All Settings remains available in the
            # header if an older Gio binding cannot report completion.
            return

    def _on_panel_command_finished(self, process, result, context):
        if self._closed:
            return
        item, index, order = context
        try:
            succeeded = bool(process.wait_check_finish(result))
        except (GLib.Error, OSError, TypeError, ValueError):
            succeeded = False
        if not succeeded:
            self._try_panel_command(item, index + 1, order)

    def _open_native_settings(self, _button: Gtk.Button | None = None):
        if self._closed:
            return
        if self._launch_desktop_app(NATIVE_SETTINGS_DESKTOP_ID, "GNOME Settings"):
            return
        self._spawn_fixed((GNOME_CONTROL_CENTER_COMMAND,), "GNOME Settings")

    def _open_local(self, item: settings_model.Destination):
        if self._closed:
            return
        if item.desktop_id and self._launch_desktop_app(f"{item.desktop_id}.desktop", item.title):
            return
        try:
            arguments = settings_model.local_command(item)
        except ValueError:
            self._show_toast(f"{item.title} is not available in this preview.")
            return
        self._spawn_fixed(arguments, item.title)

    def _show_toast(self, message: str):
        try:
            self._toast_overlay.add_toast(Adw.Toast.new(message))
        except (AttributeError, RuntimeError, TypeError):
            pass

    def shutdown(self):
        self._closed = True
        cancellable = getattr(self, "_developer_cancellable", None)
        cancel = getattr(cancellable, "cancel", None)
        if callable(cancel):
            try:
                cancel()
            except (AttributeError, GLib.Error, RuntimeError, TypeError):
                pass
        process = getattr(self, "_developer_process", None)
        force_exit = getattr(process, "force_exit", None)
        if callable(force_exit):
            try:
                force_exit()
            except (AttributeError, GLib.Error, OSError, RuntimeError, TypeError):
                pass


class SettingsApplication(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APPLICATION_ID)
        self._window: SettingsWindow | None = None

    def do_activate(self):
        if self._window is None:
            self._window = SettingsWindow(self)
            self._window.connect("close-request", self._on_window_close)
        self._window.present()

    def _on_window_close(self, window: SettingsWindow) -> bool:
        window.shutdown()
        self._window = None
        return False

    def do_shutdown(self):
        if self._window is not None:
            self._window.shutdown()
        Adw.Application.do_shutdown(self)


def main() -> int:
    return SettingsApplication().run(sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
