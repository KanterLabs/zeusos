  background: @window_bg_color;
}

.settings-hero {
  padding: 20px 36px 12px;
}

.eyebrow {
  color: @accent_color;
  font-size: 0.78em;
  font-weight: 750;
  letter-spacing: 0.12em;
}

.hero-title {
  color: @window_fg_color;
  font-size: 2em;
  font-weight: 800;
  letter-spacing: -0.035em;
  margin-top: 6px;
}

