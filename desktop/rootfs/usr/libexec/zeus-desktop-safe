#!/usr/bin/env python3
"""Toggle only the optional Zeus shell/dock and managed window styling."""
import subprocess
import sys
from gi.repository import Gio

extensions = ('dash-to-dock@micxgx.gmail.com', 'zeus-shell@kanterlabs')
action = sys.argv[1] if len(sys.argv) == 2 else ''
settings = Gio.Settings.new('org.gnome.shell')
disabled = list(settings.get_strv('disabled-extensions'))
if action in ('disable', 'fallback'):
    for extension in extensions:
        if extension not in disabled:
            disabled.append(extension)
    settings.set_strv('disabled-extensions', disabled)
    Gio.Settings.sync()
    subprocess.run(['/usr/libexec/zeus-style-sync', '--disable'], check=True)
    print('Zeus shell and dock disabled. Reopen apps for native window styling.')
elif action in ('enable', 'restore'):
    settings.set_strv('disabled-extensions', [item for item in disabled if item not in extensions])
    Gio.Settings.sync()
    subprocess.run(['/usr/libexec/zeus-style-sync', '--enable'], check=True)
    print('Zeus shell, dock and window styling restored.')
elif action == 'status':
    for extension in extensions:
        print(extension + ': ' + ('disabled' if extension in disabled else 'enabled'))
else:
    raise SystemExit('Usage: zeus-desktop-safe {disable|enable|status}')
