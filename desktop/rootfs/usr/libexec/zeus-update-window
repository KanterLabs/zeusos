#!/usr/bin/env python3
"""Native GTK window for signed Zeus OS updates.

The updater engine owns feed verification, downloads, staging, and the root
systemd job.  This process only presents the JSON contract and submits the
explicit owner actions.  All updater commands run away from the GTK main
loop; the root job's status file is observed with a directory monitor so the
window does not poll while idle.
"""

from __future__ import annotations

import concurrent.futures
from dataclasses import dataclass
import datetime as datetime_module
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from typing import Any, Callable, Mapping, Sequence

import gi

gi.require_version("Adw", "1")
gi.require_version("Gtk", "4.0")
from gi.repository import Adw, Gio, GLib, Gtk, Pango


APPLICATION_ID = "org.zeus.Updates"
UPDATE_COMMAND = "/usr/libexec/zeus-update"
UPDATE_ADMIN_COMMAND = "/usr/libexec/zeus-update-admin"
DEVELOPER_ADMIN_COMMAND = "/usr/libexec/zeus-developer-admin"
PKEXEC_COMMAND = "/usr/bin/pkexec"
STATUS_DIRECTORY = Path("/var/lib/zeus/updater")
STATUS_FILENAME = "status.json"
STATUS_PATH = STATUS_DIRECTORY / STATUS_FILENAME
DEVELOPER_STATUS_DIRECTORY = Path("/var/lib/zeus/developer-mode")
DEVELOPER_STATUS_FILENAME = "status.json"
DEVELOPER_STATUS_PATH = DEVELOPER_STATUS_DIRECTORY / DEVELOPER_STATUS_FILENAME
DEVELOPER_STATUS_LIMIT = 128 * 1024
DEVELOPER_PAUSE_ACTION = "pause-for-update"
DEVELOPER_PAUSE_COMMAND = (
    PKEXEC_COMMAND,
    "--disable-internal-agent",
    DEVELOPER_ADMIN_COMMAND,
    DEVELOPER_PAUSE_ACTION,
)
REBOOT_COMMAND = ("/usr/bin/gnome-session-quit", "--reboot")
REFRESH_DEBOUNCE_MS = 250
COMMAND_TIMEOUT_SECONDS = 120
PRODUCT_VERSION = "0.1.0-preview.2"

VALID_STATES = frozenset(
    {
        "idle",
        "available",
        "up_to_date",
        "queued",
        "downloading",
        "verifying",
        "staging",
        "ready",
        "error",
        "interrupted",
    }
)
AUTHORITATIVE_STATES = frozenset(
    {"queued", "downloading", "verifying", "staging", "ready"}
)
BUSY_STATES = frozenset({"queued", "downloading", "verifying", "staging"})
INSTALLABLE_BUILD_RE = re.compile(r"git-[0-9a-f]{12}\Z")
SHA256_RE = re.compile(r"[0-9a-f]{64}\Z")
DEVELOPER_STATES = frozenset(
    {
        "off",
        "disabled",
        "inactive",
        "enabled",
        "active",
        "applying",
        "incompatible",
        "attention",
        "needs_rebuild",
        "paused",
        "error",
        "interrupted",
        "needs_attention",
    }
)
DEVELOPER_ACTIVE_STATES = frozenset(
    {"active", "applying", "interrupted", "needs_attention", "error"}
)


def _read_text(path: Path, fallback: str) -> str:
    try:
        value = path.read_text(encoding="utf-8").strip()
    except (OSError, UnicodeError):
        return fallback
    return value or fallback


def _installed_defaults() -> dict[str, str]:
    """Return display-only fallbacks for images without a status response."""

    return {
        "version": _read_text(Path("/usr/share/zeus/version"), PRODUCT_VERSION),
        "build_id": _read_text(Path("/usr/share/zeus/build-id"), "development"),
    }


def _text(value: Any, fallback: str = "") -> str:
    if isinstance(value, str):
        return value.strip()
    if value is None:
        return fallback
    return str(value).strip()


def _nonnegative_integer(value: Any) -> int | None:
    if isinstance(value, bool):
        return None
    try:
        number = int(value)
    except (TypeError, ValueError, OverflowError):
        return None
    return number if number >= 0 else None


def _normalise_current(value: Any) -> dict[str, Any]:
    defaults = _installed_defaults()
    current = value if isinstance(value, Mapping) else {}
    result = {
        "version": _text(current.get("version"), defaults["version"]),
        "build_id": _text(current.get("build_id"), defaults["build_id"]),
    }
    sequence = _nonnegative_integer(current.get("sequence"))
    if sequence is not None:
        result["sequence"] = sequence
    return result


def _normalise_candidate(value: Any) -> dict[str, Any] | None:
    if not isinstance(value, Mapping):
        return None
    candidate: dict[str, Any] = {}
    for key in ("version", "build_id", "source_commit", "published_at", "notes"):
        value_for_key = _text(value.get(key))
        if value_for_key:
            candidate[key] = value_for_key
    sequence = _nonnegative_integer(value.get("sequence"))
    if sequence is not None:
        candidate["sequence"] = sequence
    archive_size = _nonnegative_integer(value.get("archive_size"))
    if archive_size is not None:
        candidate["archive_size"] = archive_size
    archive_sha256 = _text(value.get("archive_sha256"))
    if archive_sha256:
        candidate["archive_sha256"] = archive_sha256
    candidate["installable"] = _candidate_is_installable(candidate)
    return candidate


def _candidate_is_installable(candidate: Mapping[str, Any] | None) -> bool:
    if not isinstance(candidate, Mapping):
        return False
    build_id = candidate.get("build_id")
    archive_sha256 = candidate.get("archive_sha256")
    return bool(
        isinstance(build_id, str)
        and INSTALLABLE_BUILD_RE.fullmatch(build_id)
        and isinstance(archive_sha256, str)
        and SHA256_RE.fullmatch(archive_sha256)
    )


def _normalise_progress(value: Any) -> dict[str, int] | None:
    if not isinstance(value, Mapping):
        return None
    bytes_done = _nonnegative_integer(value.get("bytes"))
    total = _nonnegative_integer(value.get("total"))
    if bytes_done is None or total is None or total <= 0:
        return None
    return {"bytes": min(bytes_done, total), "total": total}


def _normalise_developer_status(value: Any) -> dict[str, Any] | None:
    """Reduce Developer Mode state to the fields the Updates UI needs."""

    if value is None:
        return None
    if not isinstance(value, Mapping):
        return {"state": "unknown", "active": False, "valid": False}
    raw_state = _text(value.get("state"))
    state = (
        raw_state.lower().replace("-", "_").replace(" ", "_")
        if raw_state
        else "unknown"
    )
    explicit_active = value.get("active")
    if explicit_active is not None and not isinstance(explicit_active, bool):
        return {"state": "unknown", "active": False, "valid": False}
    valid = state in DEVELOPER_STATES
    active = state in DEVELOPER_ACTIVE_STATES or explicit_active is True
    return {"state": state, "active": active, "valid": valid}


def _developer_extension_active(status: Mapping[str, Any] | None) -> bool:
    if not isinstance(status, Mapping):
        return False
    developer = status.get("developer")
    return isinstance(developer, Mapping) and developer.get("active") is True


def _normalise_status(value: Any) -> dict[str, Any] | None:
    """Keep the public JSON contract predictable before rendering it."""

    if not isinstance(value, Mapping):
        return None
    raw_state = _text(value.get("state"))
    state = raw_state.lower() if raw_state else "idle"
    if value.get("ok") is False and not raw_state:
        state = "error"
    if state not in VALID_STATES:
        state = "error"
    status: dict[str, Any] = {
        "ok": value.get("ok") is not False,
        "state": state,
        "current": _normalise_current(value.get("current")),
        "candidate": _normalise_candidate(value.get("candidate")),
        "progress": _normalise_progress(value.get("progress")),
        "message": _text(value.get("message")),
        "error": _text(value.get("error")),
        "checked_at": _text(value.get("checked_at")),
    }
    status["developer"] = _normalise_developer_status(value.get("developer"))
    # Preserve only useful contract fields.  This lets a helper response
    # carry future metadata without allowing arbitrary values into the UI.
    return status


def _is_authoritative_status(status: Mapping[str, Any] | None) -> bool:
    return isinstance(status, Mapping) and status.get("state") in AUTHORITATIVE_STATES


def _merge_authoritative_status(
    network_status: Mapping[str, Any] | None,
    authoritative_status: Mapping[str, Any] | None,
) -> dict[str, Any] | None:
    """Keep an in-flight root job ahead of a stale concurrent network check."""

    network = _normalise_status(network_status)
    authoritative = _normalise_status(authoritative_status)
    if authoritative is None or not _is_authoritative_status(authoritative):
        return network
    if network is None:
        return authoritative

    merged = dict(network)
    # The local root job owns state, progress, message, and errors.  Current
    # identity and candidate metadata can be enriched by a newer check when
    # the job record does not contain them.
    for key in ("state", "progress", "message", "error", "checked_at", "ok"):
        merged[key] = authoritative.get(key)
    if authoritative.get("candidate") is not None:
        merged["candidate"] = authoritative["candidate"]
    if authoritative.get("current") is not None:
        merged["current"] = authoritative["current"]
    return merged


def _parse_json_object(output: str) -> dict[str, Any] | None:
    if not isinstance(output, str):
        return None
    text = output.strip()
    if not text:
        return None
    try:
        parsed = json.loads(text)
    except json.JSONDecodeError:
        # The CLI contract is one JSON object.  A small amount of launcher
        # noise should not make an otherwise valid response unusable.
        start = text.find("{")
        end = text.rfind("}")
        if start < 0 or end <= start:
            return None
        try:
            parsed = json.loads(text[start : end + 1])
        except json.JSONDecodeError:
            return None
    return parsed if isinstance(parsed, dict) else None


def _command_error(payload: Mapping[str, Any] | None, stderr: str = "") -> str:
    if isinstance(payload, Mapping):
        # Error codes help diagnostics, but a human message is what belongs
        # in an owner-facing window (for example, a failed signature check
        # must not be rendered as a generic network failure).
        for key in ("message", "error"):
            value = _text(payload.get(key))
            if value:
                return value
    return _text(stderr)


@dataclass(frozen=True)
class CommandOutcome:
    payload: dict[str, Any] | None
    returncode: int | None
    error: str | None = None
    stdout: str = ""
    stderr: str = ""


def _run_json_command(arguments: Sequence[str], *, timeout: int = COMMAND_TIMEOUT_SECONDS) -> CommandOutcome:
    """Run one fixed-argv updater command without involving a shell."""

    try:
        completed = subprocess.run(
            list(arguments),
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return CommandOutcome(None, None, "The update service took too long to respond.")
    except FileNotFoundError as error:
        return CommandOutcome(None, None, f"Required updater command is unavailable: {error.filename or arguments[0]}")
    except OSError as error:
        return CommandOutcome(None, None, f"The updater could not be started: {error}")

    stdout = _text(completed.stdout)
    stderr = _text(completed.stderr)
    payload = _parse_json_object(stdout)
    error = None
    if completed.returncode != 0:
        error = _command_error(payload, stderr) or f"The updater returned exit status {completed.returncode}."
    elif payload is None:
        error = "The updater returned an unreadable response."
    elif payload.get("ok") is False:
        error = _command_error(payload, stderr) or "The updater could not complete the request."
    return CommandOutcome(payload, completed.returncode, error, stdout, stderr)


def _is_authentication_denial(outcome: CommandOutcome) -> bool:
    """pkexec uses 126/127 for canceled or denied authentication paths."""

    return outcome.returncode in (126, 127)


def _format_size(value: Any) -> str:
    number = _nonnegative_integer(value)
    if number is None:
        return "Size unavailable"
    units = ("bytes", "KiB", "MiB", "GiB", "TiB")
    amount = float(number)
    unit = units[0]
    for unit in units:
        if amount < 1024 or unit == units[-1]:
            break
        amount /= 1024
    if unit == "bytes":
        return f"{number:,} bytes"
    return f"{amount:.1f} {unit}"


def _format_timestamp(value: Any) -> str:
    timestamp = _text(value)
    if not timestamp:
        return "Date unavailable"
    try:
        parsed = datetime_module.datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=datetime_module.timezone.utc)
        parsed = parsed.astimezone()
        return parsed.strftime("%b %-d, %Y")
    except (TypeError, ValueError, OverflowError):
        return timestamp


def _monitor_event_names(*files: Gio.File | None) -> set[str]:
    names: set[str] = set()
    for file in files:
        if file is None:
            continue
        try:
            path = file.get_path()
        except (AttributeError, RuntimeError):
            continue
        if path:
            names.add(Path(path).name)
    return names


def _state_heading(state: str) -> str:
    return {
        "idle": "Ready to check",
        "available": "Update available",
        "up_to_date": "You’re up to date",
        "queued": "Update queued",
        "downloading": "Downloading update",
        "verifying": "Verifying update",
        "staging": "Preparing update",
        "ready": "Ready to restart",
        "error": "Update check needs attention",
        "interrupted": "Update interrupted",
    }.get(state, "Update status")


def _state_description(status: Mapping[str, Any]) -> str:
    state = _text(status.get("state"), "idle")
    message = _text(status.get("message"))
    if message:
        return message
    return {
        "idle": "Check when you are ready to look for a signed Zeus OS update.",
        "available": "A signed update is ready for you to review.",
        "up_to_date": "This installation has the latest signed update available to it.",
        "queued": "The update is queued and will continue in the background.",
        "downloading": "The update archive is downloading in the background.",
        "verifying": "The downloaded archive is being verified before staging.",
        "staging": "The verified update is being prepared for the next restart.",
        "ready": "The verified update is staged and will apply after you restart.",
        "error": _text(status.get("error"), "The update service could not complete the request."),
        "interrupted": _text(status.get("error"), "The update was interrupted. Check again to retry."),
    }.get(state, "The updater returned an unknown state.")


def _looks_offline(*values: Any) -> bool:
    text = " ".join(_text(value).lower() for value in values if value is not None)
    return any(
        marker in text
        for marker in (
            "offline",
            "network",
            "no route",
            "could not reach",
            "dns",
            "connection refused",
            "connection reset",
            "unable to resolve",
            "timed out",
        )
    )


def _looks_trust_error(*values: Any) -> bool:
    text = " ".join(_text(value).lower() for value in values if value is not None)
    return any(
        marker in text
        for marker in ("signature", "signed", "trust", "manifest", "verification", "verify")
    )


